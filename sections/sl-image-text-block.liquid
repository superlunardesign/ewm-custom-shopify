{% comment %}
  EWM Image + Text Block
  Side-by-side layout with image and text content, swappable positions
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .sl-itb {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sl-itb {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% if section.settings.enable_anchor %}
  <div id="{{ section.settings.anchor_id }}" style="position: relative; top: -{{ section.settings.scroll_offset }}px;"></div>
{% endif %}

<div class="sl-itb color-{{ section.settings.color_scheme }} gradient">
  {% if section.settings.enable_scroll_text %}
    <div class="sl-itb__scroll-text" aria-hidden="true">
      <div class="sl-itb__scroll-track" style="--scroll-duration: {{ section.settings.scroll_speed }}s;">
        {% for i in (1..10) %}
          <span class="sl-itb__scroll-item">{{ section.settings.scroll_text }}</span>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="sl-itb__container page-width">
    <div class="sl-itb__grid{% if section.settings.image_position == 'right' %} sl-itb__grid--reversed{% endif %}{% if section.settings.enable_animation %} sl-itb__animate{% endif %}"
      {% if section.settings.enable_animation %}
        data-sl-itb-animate
        data-duration="{{ section.settings.animation_duration }}"
        data-delay="{{ section.settings.animation_delay }}"
      {% endif %}
    >
      <div class="sl-itb__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              sizes: '(min-width: 750px) 50vw, 100vw',
              widths: '375, 550, 750, 1000, 1250, 1500',
              class: 'sl-itb__img',
              loading: 'lazy'
          }}
        {% else %}
          <div class="sl-itb__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      <div class="sl-itb__content">
        <div class="sl-itb__content-top">
          {% if section.settings.subheading != blank %}
            <p class="sl-itb__subheading">{{ section.settings.subheading }}</p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="sl-itb__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
          {% endif %}
        </div>

        <div class="sl-itb__content-bottom">
          {% if section.settings.text != blank %}
            <div class="sl-itb__text rte">{{ section.settings.text }}</div>
          {% endif %}

          {% if section.settings.show_button and section.settings.button_text != blank %}
            <div class="sl-itb__button-wrap">
              <a
                {% if section.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.button_link }}"
                {% endif %}
                class="button{% if section.settings.button_style == 'secondary' %} button--secondary{% endif %}"
              >
                {{ section.settings.button_text | escape }}
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% if section.settings.enable_animation %}
<script>
  (function() {
    function initSlItbAnimation() {
      var section = document.querySelector('#shopify-section-{{ section.id }}');
      if (!section) return;
      var target = section.querySelector('[data-sl-itb-animate]');
      if (!target) return;

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            target.classList.add('sl-itb__animate--visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      observer.observe(target);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSlItbAnimation);
    } else {
      initSlItbAnimation();
    }

    if (Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', function(e) {
        if (e.detail.sectionId === '{{ section.id }}') initSlItbAnimation();
      });
    }
  })();
</script>
{% endif %}

<style>
  {% if section.settings.overlap_above %}
    #shopify-section-{{ section.id }} {
      position: relative;
      z-index: 2;
      margin-top: -{{ section.settings.overlap_amount }}px;
    }
  {% endif %}

  /* Scrolling text behind content */
  {% if section.settings.enable_scroll_text %}
    #shopify-section-{{ section.id }} .sl-itb {
      position: relative;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .sl-itb__scroll-text {
      overflow: hidden;
      white-space: nowrap;
      padding: {{ section.settings.scroll_text_padding }}px 0;
    }

    #shopify-section-{{ section.id }} .sl-itb__scroll-track {
      display: inline-flex;
      animation: slItbScroll var(--scroll-duration) linear infinite;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .sl-itb__scroll-item {
      font-family: var(--font-heading-family);
      font-weight: var(--font-heading-weight);
      font-style: var(--font-heading-style);
      font-size: {{ section.settings.scroll_font_size }}px;
      line-height: 1;
      color: {{ section.settings.scroll_text_color }};
      padding: 0 40px;
      flex-shrink: 0;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .sl-itb__container {
      position: relative;
      z-index: 1;
      margin-top: -{{ section.settings.scroll_overlap }}px;
    }

    @keyframes slItbScroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .sl-itb__container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  #shopify-section-{{ section.id }} .sl-itb__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .sl-itb__media {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sl-itb__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .sl-itb__placeholder {
    background: rgb(var(--color-base-background-2));
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .sl-itb__placeholder .placeholder-svg {
    width: 60%;
    height: auto;
    fill: currentColor;
    opacity: 0.3;
  }

  #shopify-section-{{ section.id }} .sl-itb__content {
    display: flex;
    flex-direction: column;
    {% if section.settings.spread_content %}
      justify-content: space-between;
    {% else %}
      justify-content: center;
    {% endif %}
    padding: 2.5rem;
    background-color: {{ section.settings.content_background }};
  }

  #shopify-section-{{ section.id }} .sl-itb__content-top {
    {% if section.settings.spread_content %}
      margin-bottom: 2rem;
    {% else %}
      margin-bottom: 1.5rem;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .sl-itb__subheading {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 1rem;
    color: {{ section.settings.subheading_color }};
  }

  #shopify-section-{{ section.id }} .sl-itb__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    line-height: 1.15;
    margin-bottom: 0;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .sl-itb__text {
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin-bottom: 2rem;
  }

  #shopify-section-{{ section.id }} .sl-itb__text p {
    margin-bottom: 1em;
  }

  #shopify-section-{{ section.id }} .sl-itb__text p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .sl-itb__button-wrap {
    margin-top: 0.5rem;
  }

  /* Animation - only hide when JS is available */
  .js #shopify-section-{{ section.id }} .sl-itb__animate {
    opacity: 0;
    transform: translateY(30px);
  }

  .js #shopify-section-{{ section.id }} .sl-itb__animate.sl-itb__animate--visible {
    animation: slItbFloatIn {{ section.settings.animation_duration }}ms ease-out {{ section.settings.animation_delay }}ms forwards;
  }

  /* Fallback: if no .js class on html, or in theme editor, show content */
  .no-js #shopify-section-{{ section.id }} .sl-itb__animate,
  .shopify-design-mode #shopify-section-{{ section.id }} .sl-itb__animate {
    opacity: 1;
    transform: none;
  }

  @keyframes slItbFloatIn {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-itb__media {
      height: {{ section.settings.mobile_height }}px;
    }
  }

  /* Desktop */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sl-itb__container {
      padding-left: 5rem;
      padding-right: 5rem;
    }

    #shopify-section-{{ section.id }} .sl-itb__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: {{ section.settings.desktop_height }}px;
    }

    #shopify-section-{{ section.id }} .sl-itb__grid--reversed {
      direction: rtl;
    }

    #shopify-section-{{ section.id }} .sl-itb__grid--reversed > * {
      direction: ltr;
    }

    #shopify-section-{{ section.id }} .sl-itb__content {
      padding: 3rem;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .sl-itb__content {
      padding: 4rem;
    }
  }
</style>

{% schema %}
{
  "name": "EWM Image + Text Block",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "info": "Image side on desktop. On mobile, image always appears above."
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop Height",
      "info": "Height of the section on desktop (image crops to fit)",
      "min": 300,
      "max": 800,
      "step": 25,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile Image Height",
      "info": "Height of the image when stacked on mobile",
      "min": 200,
      "max": 500,
      "step": 25,
      "unit": "px",
      "default": 300
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Smaller uppercase text above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "1:1 Therapy Sessions"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra Large" },
        { "value": "hxxl", "label": "Extra Extra Large" }
      ],
      "default": "h1"
    },
    {
      "type": "checkbox",
      "id": "spread_content",
      "label": "Spread content vertically",
      "info": "Pushes heading to the top and body text + button to the bottom. When off, all content is grouped together in the center.",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>Share details about your services, approach, or expertise. This text area supports rich formatting so you can add emphasis where needed.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "EXPLORE MY APPROACH"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "primary", "label": "Primary (Filled)" },
        { "value": "secondary", "label": "Secondary (Outline)" }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Section Background",
      "options": [
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-1",
      "info": "Background behind the entire section (image + text)"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Text Block Background",
      "default": "#f5f0eb",
      "info": "Background color of the text content panel"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#6b6b6b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color",
      "default": "#4a4a4a"
    },
    {
      "type": "header",
      "content": "Anchor Link"
    },
    {
      "type": "checkbox",
      "id": "enable_anchor",
      "label": "Enable Anchor Link",
      "default": false
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Use this ID to link directly to this section (e.g. #therapy-sessions)"
    },
    {
      "type": "range",
      "id": "scroll_offset",
      "label": "Scroll Offset",
      "info": "Adjusts landing position when scrolling to anchor",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable Float-in Animation",
      "default": true
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Animation Duration",
      "min": 300,
      "max": 1500,
      "step": 100,
      "unit": "ms",
      "default": 600
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "Animation Delay",
      "min": 0,
      "max": 1000,
      "step": 100,
      "unit": "ms",
      "default": 200
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Overlap"
    },
    {
      "type": "checkbox",
      "id": "overlap_above",
      "label": "Overlap section above",
      "info": "Pulls this section up so it sits on top of the section above it",
      "default": false
    },
    {
      "type": "range",
      "id": "overlap_amount",
      "label": "Overlap Amount",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 60,
      "info": "How far this section overlaps the one above"
    },
    {
      "type": "header",
      "content": "Scrolling Text"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll_text",
      "label": "Enable Scrolling Text",
      "info": "Adds a scrolling marquee text behind the image and text content",
      "default": false
    },
    {
      "type": "text",
      "id": "scroll_text",
      "label": "Scrolling Text",
      "default": "MEET YOUR THERAPIST"
    },
    {
      "type": "range",
      "id": "scroll_font_size",
      "label": "Scrolling Text Size",
      "min": 30,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "color",
      "id": "scroll_text_color",
      "label": "Scrolling Text Color",
      "default": "#c4a882"
    },
    {
      "type": "range",
      "id": "scroll_text_padding",
      "label": "Scrolling Text Vertical Padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "scroll_overlap",
      "label": "Content Overlap",
      "info": "How far the image+text content overlaps the scrolling text",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "EWM Image + Text Block",
      "category": "Custom"
    }
  ]
}
{% endschema %}
