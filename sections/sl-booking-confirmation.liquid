{%- style -%}
#shopify-section-{{ section.id }} .sl-booking-conf {
  padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  text-align: {{ section.settings.text_alignment }};
}

@media (min-width: 750px) {
  #shopify-section-{{ section.id }} .sl-booking-conf {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
}

#shopify-section-{{ section.id }} .sl-booking-conf__inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

#shopify-section-{{ section.id }} .sl-booking-conf__icon {
  font-size: {{ section.settings.icon_size }}px;
  margin-bottom: 16px;
  line-height: 1;
}

#shopify-section-{{ section.id }} .sl-booking-conf__heading {
  font-family: var(--font-heading-family);
  font-weight: var(--font-heading-weight);
  font-style: var(--font-heading-style);
  font-size: {{ section.settings.heading_size_mobile }}px;
  line-height: 1.2;
  color: {{ section.settings.heading_color }};
  margin: 0 0 16px;
}

@media (min-width: 750px) {
  #shopify-section-{{ section.id }} .sl-booking-conf__heading {
    font-size: {{ section.settings.heading_size }}px;
  }
}

#shopify-section-{{ section.id }} .sl-booking-conf__body {
  font-family: var(--font-body-family);
  font-size: {{ section.settings.body_size }}px;
  line-height: 1.7;
  color: {{ section.settings.body_color }};
  margin: 0;
}

#shopify-section-{{ section.id }} .sl-booking-conf__body p {
  margin: 0 0 0.8em;
}

#shopify-section-{{ section.id }} .sl-booking-conf__body p:last-child {
  margin-bottom: 0;
}

#shopify-section-{{ section.id }} .sl-booking-conf__notice {
  display: inline-block;
  margin-top: 24px;
  padding: {{ section.settings.notice_padding_y }}px {{ section.settings.notice_padding_x }}px;
  background: {{ section.settings.notice_bg }};
  color: {{ section.settings.notice_text_color }};
  font-family: var(--font-body-family);
  font-size: {{ section.settings.notice_font_size }}px;
  font-weight: 500;
  line-height: 1.5;
  border-radius: {{ section.settings.notice_border_radius }}px;
}
{%- endstyle -%}

<div class="sl-booking-conf">
  <div class="sl-booking-conf__inner">
    {%- if section.settings.icon != blank -%}
      <div class="sl-booking-conf__icon">{{ section.settings.icon }}</div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="sl-booking-conf__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="sl-booking-conf__body">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.notice != blank -%}
      <div class="sl-booking-conf__notice">{{ section.settings.notice }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Booking Confirmation",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon (emoji)",
      "default": "✓"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You are booked!"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>A confirmation has been sent to your email address.</p><p>Please fill out the proper waiver attached in your email confirmation before arrival.</p>"
    },
    {
      "type": "text",
      "id": "notice",
      "label": "Notice / highlight text",
      "info": "Optional highlighted callout below the body text."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max content width",
      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 18,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#444444"
    },
    {
      "type": "header",
      "content": "Notice callout"
    },
    {
      "type": "color",
      "id": "notice_bg",
      "label": "Notice background",
      "default": "#d4dccb"
    },
    {
      "type": "color",
      "id": "notice_text_color",
      "label": "Notice text color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "notice_font_size",
      "label": "Notice font size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "notice_border_radius",
      "label": "Notice border radius",
      "min": 0,
      "max": 12,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "notice_padding_y",
      "label": "Notice vertical padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "notice_padding_x",
      "label": "Notice horizontal padding",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Booking Confirmation",
      "category": "Custom"
    }
  ]
}
{% endschema %}
