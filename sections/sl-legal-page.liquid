{%- comment -%}
  SL Legal Page — reusable section for legal/policy pages.
  Banner image + breadcrumbs + heading + rich text body + optional buttons.
  Assign the "legal" page template, then customise per page in the customizer.
{%- endcomment -%}

{%- style -%}

/* ── Breadcrumbs ── */
#SLLegal-{{ section.id }} .sl-legal-breadcrumbs {
  background-color: {{ section.settings.breadcrumb_bg_color }};
}
#SLLegal-{{ section.id }} .sl-legal-breadcrumbs__nav {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 2%;
  font-size: {{ section.settings.breadcrumb_font_size }}px;
  font-family: var(--font-body-family);
  line-height: 1;
}
#SLLegal-{{ section.id }} .sl-legal-breadcrumbs__nav a {
  color: {{ section.settings.breadcrumb_text_color }};
  text-decoration: none;
  opacity: 0.7;
  transition: opacity 0.2s;
}
#SLLegal-{{ section.id }} .sl-legal-breadcrumbs__nav a:hover { opacity: 1; }
#SLLegal-{{ section.id }} .sl-legal-breadcrumbs__sep {
  color: {{ section.settings.breadcrumb_text_color }};
  opacity: 0.5;
}
#SLLegal-{{ section.id }} .sl-legal-breadcrumbs__nav span[aria-current] {
  color: {{ section.settings.breadcrumb_text_color }};
}

/* ── Banner ── */
#SLLegal-{{ section.id }} .sl-legal-banner {
  position: relative;
  overflow: hidden;
  background-color: {{ section.settings.banner_bg_color }};
  min-height: {{ section.settings.banner_height_mobile }}px;
  width: 100%;
}
@media (min-width: 750px) {
  #SLLegal-{{ section.id }} .sl-legal-banner {
    min-height: {{ section.settings.banner_height }}px;
  }
}
#SLLegal-{{ section.id }} .sl-legal-banner__image {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  opacity: {{ section.settings.banner_image_opacity | divided_by: 100.0 }};
  z-index: 1;
}
#SLLegal-{{ section.id }} .sl-legal-banner__content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: {{ section.settings.banner_height_mobile }}px;
  padding: 24px 20px;
}
@media (min-width: 750px) {
  #SLLegal-{{ section.id }} .sl-legal-banner__content {
    min-height: {{ section.settings.banner_height }}px;
    padding: 40px;
  }
}
#SLLegal-{{ section.id }} .sl-legal-banner__title {
  font-family: var(--font-heading-family);
  font-size: {{ section.settings.banner_title_size_mobile }}px;
  font-weight: {{ section.settings.banner_title_weight }};
  color: {{ section.settings.banner_text_color }};
  margin: 0;
  line-height: 1.2;
  text-align: center;
}
@media (min-width: 750px) {
  #SLLegal-{{ section.id }} .sl-legal-banner__title {
    font-size: {{ section.settings.banner_title_size }}px;
  }
}

/* ── Body ── */
#SLLegal-{{ section.id }} .sl-legal-body {
  max-width: {{ section.settings.body_max_width }}px;
  margin: 0 auto;
  padding: {{ section.settings.body_padding_top_mobile }}px 20px {{ section.settings.body_padding_bottom_mobile }}px;
}
@media (min-width: 750px) {
  #SLLegal-{{ section.id }} .sl-legal-body {
    padding: {{ section.settings.body_padding_top }}px 40px {{ section.settings.body_padding_bottom }}px;
  }
}

#SLLegal-{{ section.id }} .sl-legal-body__heading {
  font-family: var(--font-heading-family);
  font-size: {{ section.settings.body_heading_size_mobile }}px;
  font-weight: 500;
  color: {{ section.settings.body_heading_color }};
  margin: 0 0 20px 0;
  line-height: 1.3;
}
@media (min-width: 750px) {
  #SLLegal-{{ section.id }} .sl-legal-body__heading {
    font-size: {{ section.settings.body_heading_size }}px;
  }
}

#SLLegal-{{ section.id }} .sl-legal-body__text {
  font-family: var(--font-body-family);
  font-size: {{ section.settings.body_text_size_mobile }}px;
  color: {{ section.settings.body_text_color }};
  line-height: 1.7;
}
@media (min-width: 750px) {
  #SLLegal-{{ section.id }} .sl-legal-body__text {
    font-size: {{ section.settings.body_text_size }}px;
  }
}
#SLLegal-{{ section.id }} .sl-legal-body__text h1,
#SLLegal-{{ section.id }} .sl-legal-body__text h2,
#SLLegal-{{ section.id }} .sl-legal-body__text h3,
#SLLegal-{{ section.id }} .sl-legal-body__text h4,
#SLLegal-{{ section.id }} .sl-legal-body__text h5,
#SLLegal-{{ section.id }} .sl-legal-body__text h6 {
  font-family: var(--font-heading-family);
  color: {{ section.settings.body_heading_color }};
  margin: 1.5em 0 0.5em;
  line-height: 1.3;
}
#SLLegal-{{ section.id }} .sl-legal-body__text p { margin: 0 0 1em; }
#SLLegal-{{ section.id }} .sl-legal-body__text p:last-child { margin-bottom: 0; }
#SLLegal-{{ section.id }} .sl-legal-body__text ul,
#SLLegal-{{ section.id }} .sl-legal-body__text ol {
  padding-left: 1.5em;
  margin: 0 0 1em;
}
#SLLegal-{{ section.id }} .sl-legal-body__text li { margin-bottom: 0.4em; }
#SLLegal-{{ section.id }} .sl-legal-body__text a {
  color: {{ section.settings.body_link_color }};
  text-decoration: underline;
}

/* ── Buttons ── */
#SLLegal-{{ section.id }} .sl-legal-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}
#SLLegal-{{ section.id }} .sl-legal-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 28px;
  font-family: var(--font-body-family);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  border-radius: 4px;
  transition: opacity 0.2s;
  cursor: pointer;
}
#SLLegal-{{ section.id }} .sl-legal-btn:hover { opacity: 0.85; }
#SLLegal-{{ section.id }} .sl-legal-btn--primary {
  background: {{ section.settings.btn_primary_bg }};
  color: {{ section.settings.btn_primary_text }};
  border: none;
}
#SLLegal-{{ section.id }} .sl-legal-btn--secondary {
  background: transparent;
  color: {{ section.settings.btn_secondary_text }};
  border: 1px solid {{ section.settings.btn_secondary_text }};
}

{%- endstyle -%}

<div id="SLLegal-{{ section.id }}">

  {%- comment -%} ── Breadcrumbs ── {%- endcomment -%}
  {%- if section.settings.show_breadcrumbs -%}
    <div class="sl-legal-breadcrumbs">
      <nav class="sl-legal-breadcrumbs__nav page-width" aria-label="Breadcrumb">
        <a href="/">Home</a>

        {%- if section.settings.breadcrumb_1_label != blank -%}
          <span class="sl-legal-breadcrumbs__sep">/</span>
          {%- if section.settings.breadcrumb_1_url != blank -%}
            <a href="{{ section.settings.breadcrumb_1_url }}">{{ section.settings.breadcrumb_1_label }}</a>
          {%- else -%}
            <span>{{ section.settings.breadcrumb_1_label }}</span>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.breadcrumb_2_label != blank -%}
          <span class="sl-legal-breadcrumbs__sep">/</span>
          {%- if section.settings.breadcrumb_2_url != blank -%}
            <a href="{{ section.settings.breadcrumb_2_url }}">{{ section.settings.breadcrumb_2_label }}</a>
          {%- else -%}
            <span>{{ section.settings.breadcrumb_2_label }}</span>
          {%- endif -%}
        {%- endif -%}

        <span class="sl-legal-breadcrumbs__sep">/</span>
        <span aria-current="page">{{ section.settings.breadcrumb_current | default: page.title }}</span>
      </nav>
    </div>
  {%- endif -%}

  {%- comment -%} ── Banner ── {%- endcomment -%}
  {%- if section.settings.show_banner -%}
    <div class="sl-legal-banner">
      {%- if section.settings.banner_image != blank -%}
        <img
          class="sl-legal-banner__image"
          srcset="{{ section.settings.banner_image | image_url: width: 375 }} 375w,
                  {{ section.settings.banner_image | image_url: width: 750 }} 750w,
                  {{ section.settings.banner_image | image_url: width: 1100 }} 1100w,
                  {{ section.settings.banner_image | image_url: width: 1500 }} 1500w,
                  {{ section.settings.banner_image | image_url: width: 1920 }} 1920w"
          src="{{ section.settings.banner_image | image_url: width: 1500 }}"
          sizes="100vw"
          alt="{{ section.settings.banner_title | default: page.title | escape }}"
          width="{{ section.settings.banner_image.width }}"
          height="{{ section.settings.banner_image.height }}"
          loading="eager"
        >
      {%- endif -%}
      <div class="sl-legal-banner__content">
        <h1 class="sl-legal-banner__title">{{ section.settings.banner_title | default: page.title }}</h1>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── Body ── {%- endcomment -%}
  <div class="sl-legal-body page-width">
    {%- if section.settings.body_heading != blank -%}
      <h2 class="sl-legal-body__heading">{{ section.settings.body_heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body_text != blank -%}
      <div class="sl-legal-body__text">{{ section.settings.body_text }}</div>
    {%- endif -%}

    {%- if section.settings.btn_1_label != blank or section.settings.btn_2_label != blank -%}
      <div class="sl-legal-buttons">
        {%- if section.settings.btn_1_label != blank -%}
          <a href="{{ section.settings.btn_1_url }}" class="sl-legal-btn sl-legal-btn--primary">
            {{ section.settings.btn_1_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.btn_2_label != blank -%}
          <a href="{{ section.settings.btn_2_url }}" class="sl-legal-btn sl-legal-btn--secondary">
            {{ section.settings.btn_2_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "SL Legal Page",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumbs"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "default": true,
      "label": "Show breadcrumbs"
    },
    {
      "type": "text",
      "id": "breadcrumb_1_label",
      "label": "Breadcrumb level 1",
      "default": "Legal",
      "info": "First crumb after Home"
    },
    {
      "type": "url",
      "id": "breadcrumb_1_url",
      "label": "Level 1 link",
      "info": "Leave blank for plain text"
    },
    {
      "type": "text",
      "id": "breadcrumb_2_label",
      "label": "Breadcrumb level 2",
      "default": "Policies",
      "info": "Optional second crumb"
    },
    {
      "type": "url",
      "id": "breadcrumb_2_url",
      "label": "Level 2 link"
    },
    {
      "type": "text",
      "id": "breadcrumb_current",
      "label": "Current page label",
      "info": "Defaults to the page title if blank"
    },
    {
      "type": "color",
      "id": "breadcrumb_bg_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "breadcrumb_text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "breadcrumb_font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "default": 13,
      "unit": "px",
      "label": "Font size"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "default": true,
      "label": "Show banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner title",
      "info": "Defaults to the page title if blank"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 100,
      "max": 500,
      "step": 10,
      "default": 220,
      "unit": "px",
      "label": "Banner height (desktop)"
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 160,
      "unit": "px",
      "label": "Banner height (mobile)"
    },
    {
      "type": "color",
      "id": "banner_bg_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "banner_text_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "banner_image_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%",
      "label": "Image opacity"
    },
    {
      "type": "range",
      "id": "banner_title_size",
      "min": 18,
      "max": 52,
      "step": 2,
      "default": 32,
      "unit": "px",
      "label": "Title size (desktop)"
    },
    {
      "type": "range",
      "id": "banner_title_size_mobile",
      "min": 16,
      "max": 36,
      "step": 2,
      "default": 24,
      "unit": "px",
      "label": "Title size (mobile)"
    },
    {
      "type": "select",
      "id": "banner_title_weight",
      "label": "Title weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Body content"
    },
    {
      "type": "text",
      "id": "body_heading",
      "label": "Heading",
      "info": "Optional heading above the rich text"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "info": "Supports headings, lists, links, bold, italic"
    },
    {
      "type": "range",
      "id": "body_max_width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "default": 800,
      "unit": "px",
      "label": "Content max width"
    },
    {
      "type": "color",
      "id": "body_heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "body_link_color",
      "label": "Link color",
      "default": "#334FB4"
    },
    {
      "type": "range",
      "id": "body_text_size",
      "min": 13,
      "max": 18,
      "step": 1,
      "default": 15,
      "unit": "px",
      "label": "Text size (desktop)"
    },
    {
      "type": "range",
      "id": "body_text_size_mobile",
      "min": 13,
      "max": 16,
      "step": 1,
      "default": 14,
      "unit": "px",
      "label": "Text size (mobile)"
    },
    {
      "type": "range",
      "id": "body_heading_size",
      "min": 18,
      "max": 36,
      "step": 1,
      "default": 24,
      "unit": "px",
      "label": "Heading size (desktop)"
    },
    {
      "type": "range",
      "id": "body_heading_size_mobile",
      "min": 16,
      "max": 28,
      "step": 1,
      "default": 20,
      "unit": "px",
      "label": "Heading size (mobile)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "body_padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Body padding top (desktop)"
    },
    {
      "type": "range",
      "id": "body_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 48,
      "unit": "px",
      "label": "Body padding bottom (desktop)"
    },
    {
      "type": "range",
      "id": "body_padding_top_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 28,
      "unit": "px",
      "label": "Body padding top (mobile)"
    },
    {
      "type": "range",
      "id": "body_padding_bottom_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Body padding bottom (mobile)"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn_1_label",
      "label": "Button 1 label"
    },
    {
      "type": "url",
      "id": "btn_1_url",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "btn_2_label",
      "label": "Button 2 label"
    },
    {
      "type": "url",
      "id": "btn_2_url",
      "label": "Button 2 link"
    },
    {
      "type": "color",
      "id": "btn_primary_bg",
      "label": "Primary button background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "btn_primary_text",
      "label": "Primary button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_secondary_text",
      "label": "Secondary button color",
      "default": "#1a1a1a"
    }
  ],
  "presets": [
    {
      "name": "SL Legal Page"
    }
  ]
}
{% endschema %}
