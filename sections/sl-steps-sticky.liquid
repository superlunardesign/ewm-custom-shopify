{% comment %}
  EWM Sticky Steps
  Step cards with sticky stacking on mobile, scrolling marquee behind
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .sl-hiw {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sl-hiw {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="sl-hiw-{{ section.id }}" class="sl-hiw">
  <div class="sl-hiw__bg" {% if section.settings.bg_type == 'color' %}style="background-color: {{ section.settings.bg_color }};"{% endif %}>
    {% if section.settings.bg_type == 'image' and section.settings.bg_image != blank %}
      {{
        section.settings.bg_image
        | image_url: width: 2000
        | image_tag:
          sizes: '100vw',
          widths: '750, 1000, 1500, 2000',
          class: 'sl-hiw__bg-img',
          loading: 'lazy'
      }}
    {% elsif section.settings.bg_type == 'video' and section.settings.bg_video != blank %}
      <video class="sl-hiw__bg-video" autoplay muted loop playsinline>
        {{ section.settings.bg_video | video_sources }}
      </video>
    {% elsif section.settings.bg_type == 'video_url' and section.settings.bg_video_url != blank %}
      <video class="sl-hiw__bg-video" autoplay muted loop playsinline>
        <source src="{{ section.settings.bg_video_url }}" type="video/mp4">
      </video>
    {% endif %}
    {% unless section.settings.bg_type == 'color' %}
      <div class="sl-hiw__overlay"></div>
    {% endunless %}
  </div>

  {% if section.settings.enable_marquee and section.settings.marquee_text != blank %}
    <div class="sl-hiw__marquee" aria-hidden="true">
      <div class="sl-hiw__marquee-track">
        {% for i in (1..12) %}
          <span class="sl-hiw__marquee-item">{{ section.settings.marquee_text }}</span>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="sl-hiw__content">
    {% if section.blocks.size > 0 %}
      <div class="sl-hiw__cards" style="--hiw-peek: {{ section.settings.peek_height }}px; --hiw-sticky-top: {{ section.settings.sticky_offset }}px;">
        {% for block in section.blocks %}
          <div class="sl-hiw__card" style="--i: {{ forloop.index0 }}; z-index: {{ forloop.index | plus: 2 }};" {{ block.shopify_attributes }}>
            <div class="sl-hiw__step-row">
              <span class="sl-hiw__step-label">{{ section.settings.step_prefix }}</span>
              <span class="sl-hiw__step-line"></span>
              <span class="sl-hiw__step-num">{% if forloop.index < 10 %}0{{ forloop.index }}{% else %}{{ forloop.index }}{% endif %}</span>
            </div>
            <div class="sl-hiw__card-body">
              {% if block.settings.heading != blank %}
                <h3 class="sl-hiw__card-heading">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="sl-hiw__card-text rte">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.show_button and section.settings.button_text != blank %}
      <div class="sl-hiw__cta">
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="button{% if section.settings.button_style == 'secondary' %} button--secondary{% elsif section.settings.button_style == 'custom' %} sl-hiw__btn-custom{% endif %}"
        >
          {{ section.settings.button_text | escape }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% if section.settings.enable_sticky %}
<script>
  (function() {
    var el = document.getElementById('sl-hiw-{{ section.id }}');
    if (!el) return;
    var node = el.parentElement;
    while (node && node !== document.body) {
      var style = window.getComputedStyle(node);
      if (style.overflow !== 'visible' || style.overflowY !== 'visible') {
        node.style.overflow = 'visible';
        node.style.overflowY = 'visible';
      }
      node = node.parentElement;
    }
  })();
</script>
{% endif %}

<style>
  /* ── Ensure sticky works — no overflow clipping on ancestors ── */
  #shopify-section-{{ section.id }} {
    overflow: visible !important;
  }

  /* ── Base ── */
  #shopify-section-{{ section.id }} .sl-hiw {
    position: relative;
    overflow: visible;
  }

  /* ── Background ── */
  #shopify-section-{{ section.id }} .sl-hiw__bg {
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .sl-hiw__bg-img,
  #shopify-section-{{ section.id }} .sl-hiw__bg-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .sl-hiw__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  }

  /* ── Marquee ── */
  #shopify-section-{{ section.id }} .sl-hiw__marquee {
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sl-hiw__marquee-track {
    display: inline-flex;
    animation: slHiwScroll-{{ section.id }} {{ section.settings.marquee_speed }}s linear infinite;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sl-hiw__marquee-item {
    flex-shrink: 0;
    padding-right: 0.25em;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
    color: {{ section.settings.marquee_color }};
    font-size: {{ section.settings.marquee_size }}px;
    {% if section.settings.marquee_font == 'heading' %}
      font-family: var(--font-heading-family);
      font-weight: var(--font-heading-weight);
      font-style: var(--font-heading-style);
    {% else %}
      font-family: var(--font-body-family);
    {% endif %}
  }

  @keyframes slHiwScroll-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ── Content layer ── */
  #shopify-section-{{ section.id }} .sl-hiw__content {
    position: relative;
    z-index: 2;
  }

  /* ── Card styling ── */
  #shopify-section-{{ section.id }} .sl-hiw__card {
    background-color: {{ section.settings.card_bg }};
    padding: 1.5rem 2rem 2rem;
    border-radius: {{ section.settings.card_radius }}px;
  }

  #shopify-section-{{ section.id }} .sl-hiw__step-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-bottom: 1rem;
    border-bottom: 1px solid {{ section.settings.step_line_color }};
    margin-bottom: 0;
    color: {{ section.settings.step_color }};
  }

  #shopify-section-{{ section.id }} .sl-hiw__step-line {
    flex: 1;
    height: 1px;
    background: {{ section.settings.step_line_color }};
  }

  #shopify-section-{{ section.id }} .sl-hiw__card-body {
    padding-top: 1.5rem;
  }

  #shopify-section-{{ section.id }} .sl-hiw__card-heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: 2.4rem;
    line-height: 1.2;
    margin-bottom: 1.2rem;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .sl-hiw__card-text {
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .sl-hiw__card-text p {
    margin-bottom: 1em;
  }

  #shopify-section-{{ section.id }} .sl-hiw__card-text p:last-child {
    margin-bottom: 0;
  }

  /* ── CTA ── */
  #shopify-section-{{ section.id }} .sl-hiw__cta {
    text-align: center;
    position: relative;
    z-index: 20;
  }

  #shopify-section-{{ section.id }} .sl-hiw__btn-custom {
    background-color: {{ section.settings.button_bg_color }} !important;
    color: {{ section.settings.button_text_color }} !important;
    border-color: {{ section.settings.button_bg_color }} !important;
  }

  /* ═══════════════════════════════════════════
     MOBILE
     ═══════════════════════════════════════════ */
  @media screen and (max-width: 749px) {
    {% if section.settings.enable_sticky %}
      /* Sticky background covers viewport while scrolling */
      #shopify-section-{{ section.id }} .sl-hiw__bg {
        position: sticky;
        top: 0;
        height: 100vh;
        margin-bottom: -100vh;
        z-index: 0;
      }

      /* Marquee in flow at top */
      #shopify-section-{{ section.id }} .sl-hiw__marquee {
        position: relative;
        z-index: 1;
        padding: 1.5rem 0;
      }

      #shopify-section-{{ section.id }} .sl-hiw__marquee-item {
        font-size: {{ section.settings.marquee_size | times: 0.35 | round: 0 }}px;
      }

      /* Cards container with scroll runway */
      #shopify-section-{{ section.id }} .sl-hiw__cards {
        padding: 1rem 1.5rem;
        padding-bottom: 30vh;
      }

      /* Each card sticks at staggered position */
      #shopify-section-{{ section.id }} .sl-hiw__card {
        position: sticky;
        top: calc(var(--hiw-sticky-top) + var(--i) * var(--hiw-peek));
        box-shadow: 0 -2px 15px rgba(0, 0, 0, 0.12);
      }

      /* Scroll space between cards */
      #shopify-section-{{ section.id }} .sl-hiw__card:not(:first-child) {
        margin-top: 65vh;
      }
    {% else %}
      /* Non-sticky: fixed background, simple stacked cards */
      #shopify-section-{{ section.id }} .sl-hiw__bg {
        position: absolute;
        inset: 0;
      }

      #shopify-section-{{ section.id }} .sl-hiw__marquee {
        position: relative;
        z-index: 1;
        padding: 1.5rem 0;
      }

      #shopify-section-{{ section.id }} .sl-hiw__marquee-item {
        font-size: {{ section.settings.marquee_size | times: 0.35 | round: 0 }}px;
      }

      #shopify-section-{{ section.id }} .sl-hiw__cards {
        padding: 1rem 1.5rem 2rem;
        display: flex;
        flex-direction: column;
        gap: {{ section.settings.card_gap }}px;
      }
    {% endif %}

    /* Button area */
    #shopify-section-{{ section.id }} .sl-hiw__cta {
      padding: 2rem 1.5rem 1rem;
    }

    #shopify-section-{{ section.id }} .sl-hiw__cta .button {
      width: 100%;
    }
  }

  /* ═══════════════════════════════════════════
     DESKTOP: side-by-side grid
     ═══════════════════════════════════════════ */
  @media screen and (min-width: 750px) {
    /* Background covers full section */
    #shopify-section-{{ section.id }} .sl-hiw__bg {
      position: absolute;
      inset: 0;
    }

    /* Marquee at top, peeking above and behind the cards */
    #shopify-section-{{ section.id }} .sl-hiw__marquee {
      position: relative;
      z-index: 1;
      padding-top: 1.5rem;
    }

    /* Content overlaps bottom of marquee text */
    #shopify-section-{{ section.id }} .sl-hiw__content {
      max-width: var(--page-width, 1200px);
      margin: -4rem auto 0;
      padding: 0 3rem 6rem;
    }

    /* Card grid */
    #shopify-section-{{ section.id }} .sl-hiw__cards {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
      gap: {{ section.settings.card_gap }}px;
    }

    #shopify-section-{{ section.id }} .sl-hiw__card-heading {
      font-size: 2.8rem;
    }

    /* Button */
    #shopify-section-{{ section.id }} .sl-hiw__cta {
      padding-top: 2.5rem;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .sl-hiw__content {
      padding: 0 5rem 8rem;
    }
  }
</style>

{% schema %}
{
  "name": "EWM Sticky Steps",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video (Upload)" },
        { "value": "video_url", "label": "Video (URL)" },
        { "value": "color", "label": "Solid Color" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image",
      "info": "Used when Background Type is 'Image'"
    },
    {
      "type": "video",
      "id": "bg_video",
      "label": "Background Video (Upload)",
      "info": "Used when Background Type is 'Video (Upload)'"
    },
    {
      "type": "text",
      "id": "bg_video_url",
      "label": "Background Video URL",
      "info": "Direct link to an .mp4 file. Used when Background Type is 'Video (URL)'"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1a1a1a",
      "info": "Used when Background Type is 'Solid Color'"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Darkness",
      "info": "Darkens the background image or video",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (Desktop)",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap Between Cards (Desktop)",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Mobile Sticky Effect"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky scroll",
      "info": "Cards stack on top of each other as you scroll on mobile. When off, cards display in a simple vertical list.",
      "default": true
    },
    {
      "type": "range",
      "id": "peek_height",
      "label": "Card Peek Height",
      "info": "How much of each card peeks through when stacked",
      "min": 40,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 58
    },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "Sticky Top Offset",
      "info": "Distance from top of screen where first card sticks (account for your header height)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Scrolling Marquee"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Enable Scrolling Text Behind",
      "default": true
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee Text",
      "default": "HOW IT WORKS"
    },
    {
      "type": "range",
      "id": "marquee_size",
      "label": "Marquee Text Size (Desktop)",
      "info": "Mobile size auto-scales to ~35%",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "color",
      "id": "marquee_color",
      "label": "Marquee Text Color",
      "default": "#6b7c5e"
    },
    {
      "type": "select",
      "id": "marquee_font",
      "label": "Marquee Font",
      "options": [
        { "value": "heading", "label": "Heading Font" },
        { "value": "body", "label": "Body Font" }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee Speed",
      "info": "Higher = slower",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 20
    },
    {
      "type": "header",
      "content": "Steps"
    },
    {
      "type": "text",
      "id": "step_prefix",
      "label": "Step Label",
      "default": "STEP"
    },
    {
      "type": "color",
      "id": "step_color",
      "label": "Step Label Color",
      "default": "#6b7c5e"
    },
    {
      "type": "color",
      "id": "step_line_color",
      "label": "Step Separator Color",
      "default": "#c4c4a0"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#f5f3ed"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Corner Radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color",
      "default": "#4a4a4a"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "BOOK HERE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "primary", "label": "Primary (Filled)" },
        { "value": "secondary", "label": "Secondary (Outline)" },
        { "value": "custom", "label": "Custom Colors" }
      ],
      "default": "primary"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Custom Button Background",
      "default": "#6b7c5e",
      "info": "Only used with 'Custom Colors' button style"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Custom Button Text Color",
      "default": "#ffffff",
      "info": "Only used with 'Custom Colors' button style"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Book an Appointment"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Share the details for this step so your customers know what to expect.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EWM Sticky Steps",
      "category": "Custom",
      "settings": {
        "enable_marquee": true,
        "marquee_text": "HOW IT WORKS"
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "heading": "Book an Appointment",
            "text": "<p>You'll get a confirmation email and we'll send you any pre-appointment forms and prep you may need to have a smooth experience.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Arrive with Clean Skin",
            "text": "<p>You'll get a confirmation email and we'll send you any pre-appointment forms and prep you may need to have a smooth experience.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Enjoy your Spa Experience",
            "text": "<p>You'll get a confirmation email and we'll send you any pre-appointment forms and prep you may need to have a smooth experience.</p>"
          }
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
