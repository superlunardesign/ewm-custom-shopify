{%- style -%}
/* =========================================================
   SL GRADIENT EDITORIAL HERO
   ========================================================= */

{%- assign overlay_opacity = section.settings.overlay_darkness | divided_by: 100.0 -%}

#shopify-section-{{ section.id }} .sl-geh {
  position: relative;
  display: flex;
  align-items: flex-end;
  min-height: {{ section.settings.mobile_height | default: 350 }}px;
  background: {{ section.settings.bg_color | default: '#1a1a1a' }};
  overflow: hidden;
}

@media (min-width: 750px) {
  #shopify-section-{{ section.id }} .sl-geh {
    min-height: {{ section.settings.desktop_height | default: 500 }}px;
  }
}

/* Background image */
#shopify-section-{{ section.id }} .sl-geh__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

#shopify-section-{{ section.id }} .sl-geh__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: {{ section.settings.image_position_x | default: 50 }}% {{ section.settings.image_position_y | default: 50 }}%;
}

/* Video background */
#shopify-section-{{ section.id }} .sl-geh__video {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
}

#shopify-section-{{ section.id }} .sl-geh__video video,
#shopify-section-{{ section.id }} .sl-geh__video iframe {
  position: absolute;
  top: 50%;
  left: 50%;
  min-width: 100%;
  min-height: 100%;
  width: auto;
  height: auto;
  transform: translate(-50%, -50%);
  object-fit: cover;
}

/* Gradient overlay — 0% opacity at top, overlay_darkness% at bottom */
#shopify-section-{{ section.id }} .sl-geh__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    to bottom,
    {{ section.settings.overlay_color | default: '#000000' | color_modify: 'alpha', 0 }} {{ section.settings.gradient_start | default: 0 }}%,
    {{ section.settings.overlay_color | default: '#000000' | color_modify: 'alpha', overlay_opacity }} 100%
  );
  pointer-events: none;
}

/* Content */
#shopify-section-{{ section.id }} .sl-geh__inner {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px clamp(1.5rem, 4vw, 3rem) {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media (min-width: 750px) {
  #shopify-section-{{ section.id }} .sl-geh__inner {
    padding: {{ section.settings.padding_top }}px clamp(1.5rem, 4vw, 3rem) {{ section.settings.padding_bottom }}px;
  }
}

#shopify-section-{{ section.id }} .sl-geh__inner--page-width {
  max-width: var(--page-width);
  margin: 0 auto;
}

/* Heading */
#shopify-section-{{ section.id }} .sl-geh__heading {
  {% if section.settings.heading_font == 'body' %}
    font-family: var(--font-body-family);
  {% else %}
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
  {% endif %}
  font-size: {{ section.settings.heading_size_mobile | default: 48 }}px;
  font-weight: {{ section.settings.heading_weight | default: '400' }};
  line-height: {{ section.settings.heading_line_height | default: 1.0 }};
  letter-spacing: {{ section.settings.heading_letter_spacing | default: 0 | times: 0.01 }}em;
  text-transform: {{ section.settings.heading_transform | default: 'uppercase' }};
  color: {{ section.settings.text_color | default: '#ffffff' }};
  margin: 0;
  text-align: {{ section.settings.text_alignment | default: 'left' }};
  max-width: {{ section.settings.heading_max_width | default: 100 }}%;
}

@media (min-width: 750px) {
  #shopify-section-{{ section.id }} .sl-geh__heading {
    font-size: {{ section.settings.heading_size | default: 96 }}px;
  }
}

/* Subheading */
#shopify-section-{{ section.id }} .sl-geh__subheading {
  {% if section.settings.subheading_font == 'body' %}
    font-family: var(--font-body-family);
  {% else %}
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
  {% endif %}
  font-size: {{ section.settings.subheading_size | default: 14 }}px;
  font-weight: {{ section.settings.subheading_weight | default: '400' }};
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: {{ section.settings.text_color | default: '#ffffff' }};
  margin: 0 0 16px;
  text-align: {{ section.settings.text_alignment | default: 'left' }};
}

{%- endstyle -%}

<div class="sl-geh">
  {%- if section.settings.bg_type == 'image' and section.settings.bg_image != blank -%}
    <div class="sl-geh__bg">
      <img
        src="{{ section.settings.bg_image | image_url: width: 2400 }}"
        srcset="{{ section.settings.bg_image | image_url: width: 800 }} 800w, {{ section.settings.bg_image | image_url: width: 1200 }} 1200w, {{ section.settings.bg_image | image_url: width: 1800 }} 1800w, {{ section.settings.bg_image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.bg_image.alt | escape }}"
        loading="eager"
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.height }}"
      >
    </div>
  {%- elsif section.settings.bg_type == 'video' -%}
    <div class="sl-geh__video">
      {%- if section.settings.bg_video != blank -%}
        {{ section.settings.bg_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
      {%- elsif section.settings.bg_video_url != blank -%}
        {%- assign video_url = section.settings.bg_video_url -%}
        {%- if video_url contains 'youtube.com' or video_url contains 'youtu.be' -%}
          {%- if video_url contains 'youtu.be' -%}
            {%- assign yt_id = video_url | split: 'youtu.be/' | last | split: '?' | first -%}
          {%- else -%}
            {%- assign yt_id = video_url | split: 'v=' | last | split: '&' | first -%}
          {%- endif -%}
          <iframe src="https://www.youtube.com/embed/{{ yt_id }}?autoplay=1&mute=1&loop=1&playlist={{ yt_id }}&controls=0&showinfo=0&modestbranding=1&playsinline=1" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
        {%- elsif video_url contains 'vimeo.com' -%}
          {%- assign vimeo_id = video_url | split: 'vimeo.com/' | last | split: '?' | first -%}
          <iframe src="https://player.vimeo.com/video/{{ vimeo_id }}?autoplay=1&muted=1&loop=1&background=1" frameborder="0" allow="autoplay" allowfullscreen></iframe>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="sl-geh__overlay"></div>

  <div class="sl-geh__inner {% unless section.settings.full_width %}sl-geh__inner--page-width{% endunless %}">
    {%- if section.settings.subheading != blank -%}
      <p class="sl-geh__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="sl-geh__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
  </div>
</div>

{% schema %}
