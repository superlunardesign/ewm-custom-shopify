{% comment %}
  Responsive Split Section - Simplified Version
  Essential customization options only
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    width: 100vw;
    max-width: 1440px;
    margin: auto;
    {% if section.settings.auto_height_desktop %}
      height: auto;
    {% else %}
      height: {{ section.settings.section_height_desktop }}vw;
    {% endif %}
    padding: {{ section.settings.wrapper_padding }}%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .box1 {
    grid-column: {% if section.settings.swap_horizontal %}2{% else %}1{% endif %};
    grid-row: 1;
    {% if section.settings.image != blank %}
      background-image: url('{{ section.settings.image | image_url: width: 1500 }}');
    {% endif %}
    height: auto;
    {% if section.settings.auto_height_desktop %}
      min-height: 400px;
    {% endif %}
    background-position: {{ section.settings.image_position_x }}% {{ section.settings.image_position_y }}%;
    background-size: cover;
  }

  #shopify-section-{{ section.id }} .box2 {
    grid-column: {% if section.settings.swap_horizontal %}1{% else %}2{% endif %};
    grid-row: 1;
    padding: 5%;
    align-content: center;
  }

  #shopify-section-{{ section.id }} .box2 h2 {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .box2 h4 {
    color: {{ section.settings.subheading_color }};
    font-size: {{ section.settings.subheading_size }}px;
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .box2 p {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.6;
    margin-bottom: 15px;
  }

  #shopify-section-{{ section.id }} .custom-button {
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    padding: 2% 3%;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
    {% if section.settings.button_border_radius > 0 %}
      border-radius: {{ section.settings.button_border_radius }}px;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .custom-button:hover {
    background-color: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_text_color }};
  }

  /* Tablet Layout */
  @media (max-width: 1100px) {
    #shopify-section-{{ section.id }} .wrapper {
      grid-template-columns: repeat(3, 1fr);
      {% if section.settings.auto_height_tablet %}
        height: auto;
      {% else %}
        height: {{ section.settings.section_height_tablet }}vw;
      {% endif %}
      padding: {{ section.settings.wrapper_padding_tablet }}%;
    }
    
    #shopify-section-{{ section.id }} .box1 {
      {% if section.settings.swap_horizontal %}
        grid-column-start: 3;
        grid-column-end: 4;
      {% else %}
        grid-column-start: 1;
        grid-column-end: 2;
      {% endif %}
      width: 33vw;
      {% if section.settings.auto_height_tablet %}
        min-height: 300px;
      {% endif %}
    }
    
    #shopify-section-{{ section.id }} .box2 {
      {% if section.settings.swap_horizontal %}
        grid-column-start: 1;
        grid-column-end: 3;
      {% else %}
        grid-column-start: 2;
        grid-column-end: 4;
      {% endif %}
      grid-row: 1;
    }
  }

  /* Mobile Layout */
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .wrapper {
      grid-template-columns: 1fr;
      height: auto;
      padding: {{ section.settings.wrapper_padding_mobile }}%;
    }
    
    #shopify-section-{{ section.id }} .box1 {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
      height: 40vh;
    }
    
    #shopify-section-{{ section.id }} .box2 {
      grid-column: 1;
      grid-row: 2;
    }

    #shopify-section-{{ section.id }} .box2 h2 {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .box2 h4 {
      font-size: {{ section.settings.mobile_subheading_size }}px;
    }

    #shopify-section-{{ section.id }} .box2 p {
      font-size: {{ section.settings.mobile_text_size }}px;
    }
  }

  /* Animation Keyframes */
  @keyframes floatIn {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Apply animations when enabled */
  {% if section.settings.enable_animation %}
    #shopify-section-{{ section.id }} .box2 {
      animation: floatIn {{ section.settings.animation_duration }}ms ease-out;
      animation-delay: {{ section.settings.animation_delay }}ms;
      animation-fill-mode: both;
    }
  {% endif %}
</style>

<div class="wrapper">
  {% if section.settings.swap_horizontal %}
    <div class="box2">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      
      {% if section.settings.subheading != blank %}
        <h4>{{ section.settings.subheading }}</h4>
      {% endif %}
      
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text | newline_to_br }}</p>
      {% endif %}
      
      {% if section.settings.text2 != blank %}
        <p>{{ section.settings.text2 | newline_to_br }}</p>
      {% endif %}
      
      {% if section.settings.show_button and section.settings.button_text != blank %}
        <br><br>
        <a class="custom-button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
    <div class="box1">&nbsp;</div>
  {% else %}
    <div class="box1">&nbsp;</div>
    <div class="box2">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      
      {% if section.settings.subheading != blank %}
        <h4>{{ section.settings.subheading }}</h4>
      {% endif %}
 
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text | newline_to_br }}</p>
      {% endif %}
      
      {% if section.settings.text2 != blank %}
        <p>{{ section.settings.text2 | newline_to_br }}</p>
      {% endif %}
      
      {% if section.settings.show_button and section.settings.button_text != blank %}
        <br><br>
        <a class="custom-button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  {% endif %}
</div>

{% if section.settings.enable_animation %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('#shopify-section-{{ section.id }}');
    const valueProps = section.querySelectorAll('.box2');
    
    // Reset animations initially
    valueProps.forEach(function(elem) {
      elem.style.animationPlayState = 'paused';
    });
    
    // Create intersection observer
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.2
    };
    
    const observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          // Trigger animations for all value props
          valueProps.forEach(function(elem) {
            elem.style.animationPlayState = 'running';
          });
          // Unobserve after triggering
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);
    
    // Observe the section
    observer.observe(section);
  });
</script>
{% endif %}

{% schema %}
{
  "name": "Split Section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
