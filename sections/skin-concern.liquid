{% comment %}
  Skin Concern Timeline Section with Card Subheadings on Mobile

  Settings:
  - section_heading: Main section title
  Blocks (concern_service):
  - concern_icon: Concern icon image
  - concern_title: Skin concern
  - concern_desc: Concern description
  - service_image: Service image
  - service_title: Service name
  - service_desc: Service blurb
  - service_link: Book now URL
{% endcomment %}

<style>
  .concern-timeline {
    padding: 60px 20px;
    max-width: 1400px;
    margin: 0 auto;
  }
  .concern-timeline h2 {
    text-align: center;
    margin-bottom: 40px;
    font-size: 36px;
    color: #6b5b9a;
  }

  .timeline-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: sticky;
    top: 80px;
    z-index: 5;
  }
  .timeline-header .col {
    padding: 12px 0;
    text-align: center;
    font-size: 18px;
    font-weight: 600;
    color: #333;
  }
  .timeline-header .col:nth-child(1) { background: #f3f0f8; }
  .timeline-header .col:nth-child(2) { background: #ebf0e9; }

  .timeline-wrapper {
    display: flex;
    flex-direction: column;
    gap: 60px;
    margin-top: 5px;
  }

  .timeline-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
    padding: 40px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    transition: background 0.3s;
  }
  .timeline-panel:hover { background: #f9f9f9; }

  .concern, .service {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .concern-icon { width: 50px; height: 50px; }
  .concern-title {
    font-size: 24px;
    color: #4a4a4a;
    font-weight: 500;
    margin: 0;
  }
  .concern-desc {
    font-size: 16px;
    color: #666;
    margin: 0;
  }

  .service-img {
    width: 100%;
    max-height: 200px;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
  }
  .service-title {
    font-size: 22px;
    color: #4a4a4a;
    font-weight: 500;
    margin: 0;
  }
  .service-desc {
    font-size: 16px;
    color: #666;
    margin: 0;
  }
  .service-cta {
    display: inline-block;
    margin-top: auto;
    padding: 10px 20px;
    border: 2px solid #8b7cb6;
    border-radius: 6px;
    text-transform: uppercase;
    font-size: 14px;
    color: #8b7cb6;
    align-self: start;
    transition: background 0.3s, color 0.3s;
  }
  .service-cta:hover {
    background: #8b7cb6;
    color: #fff;
  }

  /* Card subheadings (mobile only) */
  .card-subheading {
    display: none;
    font-size: 14px;
    color: #6b5b9a;
    font-weight: 600;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .timeline-header { display: none; }
    .timeline-wrapper { gap: 40px; }
    .timeline-panel {
      display: flex;
      flex-direction: column;
      padding: 30px;
      gap: 20px;
    }
    .concern .card-subheading,
    .service .card-subheading {
      display: block;
    }
    .service-cta { align-self: center; }
  }
</style>

<section class="concern-timeline">
  <p style="width: 60%;">{{ section.settings.section_subheading }}</p>
  <h2>{{ section.settings.section_heading }}</h2>
  <div class="timeline-header">
    <div class="col">IF YOU’RE EXPERIENCING…</div>
    <div class="col">TRY OUR…</div>
  </div>
  <div class="timeline-wrapper">
    {% for block in section.blocks %}
      <div class="timeline-panel">
        <div class="concern">
          <div class="card-subheading">If you’re experiencing…</div>
          {% if block.settings.concern_icon %}
            <img src="{{ block.settings.concern_icon | img_url:'80x80' }}" class="concern-icon" alt="">
          {% endif %}
          <h3 class="concern-title">{{ block.settings.concern_title }}</h3>
          <p class="concern-desc">{{ block.settings.concern_desc }}</p>
        </div>
        <div class="service">
          <div class="card-subheading">Try our…</div>
          {% if block.settings.service_image %}
            <img src="{{ block.settings.service_image | img_url:'300x200' }}" class="service-img" alt="">
          {% endif %}
          <h4 class="service-title">{{ block.settings.service_title }}</h4>
          <p class="service-desc">{{ block.settings.service_desc }}</p>
          <a href="{{ block.settings.service_link }}" class="service-cta">Book Now</a>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Skin Concern Timeline",
  "settings": [
    { "type": "text", "id": "section_subheading", "label": "Section Heading", "default": "Match Your Skin Concern to the Perfect Treatment" }
  ,{ "type": "text", "id": "section_heading", "label": "Section Heading", "default": "Match Your Skin Concern to the Perfect Treatment" }
  ],
  "blocks": [
    {
      "type": "concern_service",
      "name": "Concern & Service Pair",
      "settings": [
        { "type":"image_picker","id":"concern_icon","label":"Concern Icon" },
        { "type":"text","id":"concern_title","label":"Skin Concern","default":"Acne & Breakouts" },
        { "type":"textarea","id":"concern_desc","label":"Concern Description","default":"Persistent pimples, redness, and inflammation." },
        { "type":"image_picker","id":"service_image","label":"Service Image" },
        { "type":"text","id":"service_title","label":"Service Name","default":"Clear Skin Facial" },
        { "type":"textarea","id":"service_desc","label":"Service Blurb","default":"A deep-cleansing facial that targets breakouts with antibacterial masks and gentle extractions." },
        { "type":"url","id":"service_link","label":"Book Now URL" }
      ]
    }
  ],
  "presets": [
    { "name": "Skin Concern Timeline", "category": "Custom", "settings": {}, "blocks": [
      { "type": "concern_service", "settings": { "concern_title": "Acne & Breakouts", "concern_desc": "Persistent pimples, redness, and inflammation.", "service_title": "Clear Skin Facial", "service_desc": "A deep-cleansing facial that targets breakouts with antibacterial masks and gentle extractions." } }
    ] }
  ],
  "max_blocks": 10
}
{% endschema %}