  {% if section.settings.show_gdpr %}

  <div class="cookie-disclaimer {{ section.settings.style}}" > 
    <div class="cookie-content color-{{ section.settings.color_scheme }} gradient">
      <p>{{ section.settings.text}}</p>
      <div class="cookie-button">
      <button type="button" class="button accept-cookie">{{ section.settings.accept}}</button>
      <button type="button" class="button decline-cookie">{{ section.settings.decline}}</button>  
      </div>
    </div>
  </div>

  <style>
    .cookie-disclaimer {
      display: none;
      position: fixed !important;
      bottom: 15px;
      left: 0;
      right: 0;
      z-index: 1000;
      pointer-events: none;
      top: auto !important;
    }
    .cookie-disclaimer .cookie-content {
      pointer-events: auto;
      max-width: 500px;
      margin: 0 auto;
      padding: 15px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-shadow: rgba(149, 157, 165, 0.4) 0px 8px 24px;
    }
    .cookie-disclaimer .cookie-content p {
      font-size: {{ section.settings.text_font_size | default: 16 }}px; letter-spacing: normal;
    }
    .cookie-disclaimer .cookie-content > * {
      margin: 5px;
    }
    .cookie-disclaimer.bottom {
      bottom: 0;
    }
    .cookie-disclaimer.bottom .cookie-content {
      padding: 10px 0;
      max-width: 100%;
      border-radius: 0;
    }
    .cookie-disclaimer.left {
      left: 15px;
      right: auto;
    }
    .cookie-disclaimer.left .cookie-content {
      max-width: 500px;
      margin: 0;
    }
    .cookie-disclaimer.right {
      left: auto;
      right: 15px;
    }
    .cookie-disclaimer.right .cookie-content {
      max-width: 500px;
      margin: 0;
    }
    .cookie-disclaimer .cookie-content button {
      font-size: {{ section.settings.button_font_size | default: 15 }}px;
      padding: {{ section.settings.button_padding | default: '10px 30px' }};
      min-width: calc(10rem + var(--buttons-border-width) * 2);
      min-height: calc(3.5rem + var(--buttons-border-width) * 2);
      transition: all 300ms linear;
      text-transform: uppercase;
      font-weight: 600;
      border: 1.5px solid var(--gradient-base-accent-1);
      background: var(--gradient-base-accent-1);
      color: #ffffff;
      line-height: 1.4;
      letter-spacing: 0.08em;
      border-radius: 0;
      font-family: var(--font-body-family);
    }

    .cookie-disclaimer.left .cookie-content{flex-direction: column;}
    .cookie-disclaimer .cookie-content .cookie-button .button.decline-cookie:last-child{
      background: transparent; color: var(--gradient-base-accent-1); border-color: var(--gradient-base-accent-1);
    }
    .cookie-disclaimer .cookie-content .button:first-child:hover{
      background: transparent;
      color: var(--gradient-base-accent-1);
    }
    .cookie-disclaimer .cookie-content .button:last-child:hover{
      background: var(--gradient-base-accent-1); color: #ffffff;
    }


    @media screen and (max-width: 767px){
      .cookie-disclaimer {
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
      }
      .cookie-disclaimer .cookie-content {
        max-width: 100%;
      }
      .cookie-disclaimer .cookie-content > p {width: 100%;}
    }
    .cookie-content .button:hover {
      background: transparent;
      color: var(--gradient-base-accent-1);
    }
  </style>

  <script type="text/javascript">

  jQuery(document).ready(function() {
    var cookie = false;
    var cookieContent = $('.cookie-disclaimer');
    if (cookieContent.length) document.body.appendChild(cookieContent[0]);
    
    checkCookie();

    if (cookie === false) {
      cookieContent.css("display","flex");
    }
    
    if (cookie === true) {
      cookieContent.css("display","none");
    }
    
    function setCookie(cname, cvalue, exdays) {
  		var d = new Date();
  		d.setTime(d.getTime() + (exdays*24*60*60*1000));
  		var expires = "expires="+ d.toUTCString();
  		document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";

	}
    
    function getCookie(cname) {
  		var name = cname + "=";
  		var decodedCookie = decodeURIComponent(document.cookie);
  		var ca = decodedCookie.split(';');
  		for(var i = 0; i < ca.length; i++) {
    	var c = ca[i];
    	while (c.charAt(0) == ' ') {
      	c = c.substring(1);
    	}
    	if (c.indexOf(name) == 0) {
      		return c.substring(name.length, c.length);
    	}
  		}
  		return "";
	}
    
    function checkCookie() {
      var user = getCookie("hldn_consent_choice");
      if (user !== "") {        
        cookie = true;
        if (user === "accepted") {                  
        }
      }
    }

    $('.accept-cookie').click(function () {
      setCookie("hldn_consent_choice", "accepted", 365);
      cookieContent.css("display","none");
    });

    $('.decline-cookie').click(function () {    
      setCookie("hldn_consent_choice", "declined", 365);
      cookieContent.css("display","none");
    });
  });
   
  </script>
  {% endif %}
  {% schema %}
  {
  "name": "t:sections.cookie-banner.name",
  "class": "gdpr-section",
  "settings": [
  {
  "type": "checkbox",
  "id": "show_gdpr",
  "label": "t:sections.cookie-banner.settings.show_gdpr.label"
  },
  {
  "type": "select",
  "id": "style",
  "label": "t:sections.cookie-banner.settings.style.label",
  "default": "bottom", 
  "options": [
  {
  "value": "bottom",
  "label": "t:sections.cookie-banner.settings.style.options__1.label"
  },
  {
  "value": "left",
  "label": "t:sections.cookie-banner.settings.style.options__2.label"
  },        
  {
  "value": "right",
  "label": "t:sections.cookie-banner.settings.style.options__3.label"
  }
  ]
  },
  {
   "type": "select",
   "id": "color_scheme",
   "options": [
    {
     "value": "accent-1",
     "label": "t:sections.all.colors.accent_1.label"
    },
    {
     "value": "accent-2",
     "label": "t:sections.all.colors.accent_2.label"
    },
    {
     "value": "background-1",
     "label": "t:sections.all.colors.background_1.label"
     },
     {
     "value": "background-2",
     "label": "t:sections.all.colors.background_2.label"
     },
     {
     "value": "inverse",
     "label": "t:sections.all.colors.inverse.label"
     }
     ],
      "default": "background-1",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.cookie-banner.settings.color_scheme.info"
    },  
  {
  "type": "textarea",
  "id": "text",
  "label": "t:sections.cookie-banner.settings.text.label",
  "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
  },  
  {
  "type": "text",
  "id": "accept",
  "label": "t:sections.cookie-banner.settings.accept.label",
  "default": "Accept"
  },
  {
  "type": "text",
  "id": "decline",
  "label": "t:sections.cookie-banner.settings.decline.label",
  "default": "Decline"
  },
  {
  "type": "range",
  "id": "text_font_size",
  "label": "Banner text font size",
  "min": 12,
  "max": 24,
  "step": 1,
  "default": 16,
  "unit": "px"
  },
  {
  "type": "range",
  "id": "button_font_size",
  "label": "Button font size",
  "min": 10,
  "max": 24,
  "step": 1,
  "default": 15,
  "unit": "px"
  },
  {
  "type": "text",
  "id": "button_padding",
  "label": "Button padding",
  "default": "10px 30px",
  "info": "CSS padding (e.g. 10px 30px or 8px 20px 8px 20px)"
  }
  ]
  }
  {% endschema %}