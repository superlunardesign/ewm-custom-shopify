{% comment %}
  EWM Resource Portal
  Sidebar file list + inline PDF viewer (no modal)
  Downloads are managed via metaobjects (Content > Resource Downloads)
  and connected to this page via page metafields.
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .sl-rp {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sl-rp {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign gate_tag = section.settings.required_tag
  assign gate_pass = true
  if gate_tag != blank
    assign gate_pass = false
    if customer
      for tag in customer.tags
        if tag == gate_tag
          assign gate_pass = true
          break
        endif
      endfor
    endif
  endif
-%}

{%- if gate_pass -%}
{%- assign tab_1_items = page.metafields.custom.tab_1_downloads.value -%}
{%- assign tab_2_items = page.metafields.custom.tab_2_downloads.value -%}

<div class="sl-rp" style="background-color: {{ section.settings.bg_color }};">

  {% if section.settings.heading != blank %}
    <div class="sl-rp__header">
      <h2 class="sl-rp__heading {{ section.settings.heading_size }}" style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    </div>
  {% endif %}

  <nav class="sl-rp__tabs" aria-label="Resource tabs">
    <button class="sl-rp__tab sl-rp__tab--active" data-sl-rp-tab="1" data-section="{{ section.id }}">
      {{ section.settings.tab_1_label | default: 'Downloads' }}
    </button>
    {% if section.settings.tab_2_label != blank %}
      <button class="sl-rp__tab" data-sl-rp-tab="2" data-section="{{ section.id }}">
        {{ section.settings.tab_2_label }}
      </button>
    {% endif %}
    {% if section.settings.tab_3_label != blank %}
      {% if section.settings.tab_3_link != blank %}
        <a href="{{ section.settings.tab_3_link }}" class="sl-rp__tab" target="_blank" rel="noopener">
          {{ section.settings.tab_3_label }}
        </a>
      {% else %}
        <button class="sl-rp__tab" data-sl-rp-tab="3" data-section="{{ section.id }}">
          {{ section.settings.tab_3_label }}
        </button>
      {% endif %}
    {% endif %}
  </nav>

  <div class="sl-rp__layout" data-section="{{ section.id }}">

    {%- comment -%} ── Sidebar ── {%- endcomment -%}
    <div class="sl-rp__sidebar">

      {%- comment -%} Tab 1 panel {%- endcomment -%}
      <div class="sl-rp__panel sl-rp__panel--active" data-sl-rp-panel="1" data-section="{{ section.id }}">
        {% if tab_1_items %}
          {% for item in tab_1_items %}
            {%- assign file_url = item.file.value.url -%}
            {%- assign card_title = item.title.value | default: item.system.display_name -%}
            <button
              class="sl-rp__card{% if forloop.first %} sl-rp__card--active{% endif %}"
              data-sl-rp-open
              data-pdf-url="{{ file_url }}"
              data-pdf-title="{{ card_title | escape }}"
              data-section="{{ section.id }}"
              type="button"
            >
              <span class="sl-rp__card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </span>
              <span class="sl-rp__card-info">
                <span class="sl-rp__card-title">{{ card_title }}</span>
                {% if item.description.value != blank %}
                  <span class="sl-rp__card-desc">{{ item.description.value }}</span>
                {% endif %}
                {% if item.last_updated.value != blank %}
                  <span class="sl-rp__card-updated">Updated {{ item.last_updated.value }}</span>
                {% endif %}
              </span>
            </button>
          {% endfor %}
        {% else %}
          <p class="sl-rp__empty">No downloads added yet.</p>
        {% endif %}
      </div>

      {%- comment -%} Tab 2 panel {%- endcomment -%}
      <div class="sl-rp__panel" data-sl-rp-panel="2" data-section="{{ section.id }}">
        {% if tab_2_items %}
          {% for item in tab_2_items %}
            {%- assign file_url = item.file.value.url -%}
            {%- assign card_title = item.title.value | default: item.system.display_name -%}
            <button
              class="sl-rp__card"
              data-sl-rp-open
              data-pdf-url="{{ file_url }}"
              data-pdf-title="{{ card_title | escape }}"
              data-section="{{ section.id }}"
              type="button"
            >
              <span class="sl-rp__card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </span>
              <span class="sl-rp__card-info">
                <span class="sl-rp__card-title">{{ card_title }}</span>
                {% if item.description.value != blank %}
                  <span class="sl-rp__card-desc">{{ item.description.value }}</span>
                {% endif %}
                {% if item.last_updated.value != blank %}
                  <span class="sl-rp__card-updated">Updated {{ item.last_updated.value }}</span>
                {% endif %}
              </span>
            </button>
          {% endfor %}
        {% else %}
          <p class="sl-rp__empty">No downloads added to this tab yet.</p>
        {% endif %}
      </div>

    </div>

    {%- comment -%} ── Inline PDF Viewer ── {%- endcomment -%}
    <div class="sl-rp__viewer" data-sl-rp-viewer data-section="{{ section.id }}">
      <div class="sl-rp__viewer-toolbar">
        <h3 class="sl-rp__viewer-title" data-sl-rp-viewer-title>Select a document to view</h3>
        <div class="sl-rp__viewer-actions" data-sl-rp-viewer-actions style="display:none;">
          <button type="button" class="sl-rp__viewer-btn" data-sl-rp-print data-section="{{ section.id }}" title="Print">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
          </button>
          <a class="sl-rp__viewer-btn" data-sl-rp-download data-section="{{ section.id }}" title="Download" download>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </a>
          <a class="sl-rp__viewer-btn" data-sl-rp-newtab data-section="{{ section.id }}" title="Open in new tab" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>
      </div>
      <div class="sl-rp__viewer-body">
        <iframe class="sl-rp__viewer-iframe" data-sl-rp-iframe data-section="{{ section.id }}"></iframe>
        <div class="sl-rp__viewer-empty" data-sl-rp-viewer-empty>
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.3;">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
          <span>Click a document to preview it here</span>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* ── Section ── */
  #shopify-section-{{ section.id }} .sl-rp {
    position: relative;
  }

  #shopify-section-{{ section.id }} .sl-rp__header {
    text-align: center;
    {% unless section.settings.full_width %}max-width: var(--page-width, 1200px);{% endunless %}
    margin: 0 auto;
    padding: 0 1.5rem 0;
  }

  #shopify-section-{{ section.id }} .sl-rp__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    line-height: 1.15;
    margin: 0 0 2rem;
  }

  /* ── Tabs ── */
  #shopify-section-{{ section.id }} .sl-rp__tabs {
    display: flex;
    background-color: {{ section.settings.tab_bg_color }};
    {% unless section.settings.full_width %}max-width: var(--page-width, 1200px);{% endunless %}
    margin: 0 auto 0;
  }

  #shopify-section-{{ section.id }} .sl-rp__tab {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.4rem 1.5rem;
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ section.settings.tab_text_color }};
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
    position: relative;
  }

  #shopify-section-{{ section.id }} .sl-rp__tab::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background-color: {{ section.settings.tab_active_color }};
    transition: width 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sl-rp__tab:hover::after,
  #shopify-section-{{ section.id }} .sl-rp__tab--active::after {
    width: 80%;
  }

  #shopify-section-{{ section.id }} .sl-rp__tab--active {
    color: {{ section.settings.tab_active_color }};
  }

  /* ── Split layout ── */
  #shopify-section-{{ section.id }} .sl-rp__layout {
    display: flex;
    flex-direction: column;
    {% unless section.settings.full_width %}max-width: var(--page-width, 1200px);{% endunless %}
    margin: 0 auto;
    padding: 0 1.5rem;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .sl-rp__panel {
    display: none;
  }

  #shopify-section-{{ section.id }} .sl-rp__panel--active {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.card_gap }}px;
  }

  #shopify-section-{{ section.id }} .sl-rp__empty {
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    color: #999;
    text-align: center;
    padding: 3rem 0;
  }

  /* ── Sidebar ── */
  #shopify-section-{{ section.id }} .sl-rp__sidebar {
    padding-top: 2rem;
  }

  /* ── Download card ── */
  #shopify-section-{{ section.id }} .sl-rp__card {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1.2rem 1.4rem;
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    background-color: {{ section.settings.card_bg_color }};
    cursor: pointer;
    text-align: left;
    text-decoration: none;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
    font-family: var(--font-body-family);
  }

  #shopify-section-{{ section.id }} .sl-rp__card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    border-color: {{ section.settings.icon_color }};
  }

  #shopify-section-{{ section.id }} .sl-rp__card--active {
    border-color: {{ section.settings.icon_color }};
    box-shadow: 0 0 0 1px {{ section.settings.icon_color }};
  }

  #shopify-section-{{ section.id }} .sl-rp__card-icon {
    flex-shrink: 0;
    color: {{ section.settings.icon_color }};
    display: flex;
  }

  #shopify-section-{{ section.id }} .sl-rp__card-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .sl-rp__card-title {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: {{ section.settings.card_text_color }};
  }

  #shopify-section-{{ section.id }} .sl-rp__card-desc {
    font-size: 1.2rem;
    font-weight: 400;
    color: {{ section.settings.card_desc_color }};
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .sl-rp__card-updated {
    font-size: 1.1rem;
    font-weight: 400;
    font-style: italic;
    color: #999;
  }

  /* ── Viewer ── */
  #shopify-section-{{ section.id }} .sl-rp__viewer {
    display: none;
    flex-direction: column;
    border: 1px solid #e0e0e0;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    background: #fafafa;
    min-height: 500px;
  }

  #shopify-section-{{ section.id }} .sl-rp__viewer--active {
    display: flex;
  }

  #shopify-section-{{ section.id }} .sl-rp__viewer-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.4rem;
    border-bottom: 1px solid #e0e0e0;
    background: #f5f5f5;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .sl-rp__viewer-title {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #1a1a1a;
    margin: 0;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #shopify-section-{{ section.id }} .sl-rp__viewer-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sl-rp__viewer-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #555;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  #shopify-section-{{ section.id }} .sl-rp__viewer-btn:hover {
    background: #e0e0e0;
    color: #1a1a1a;
  }

  #shopify-section-{{ section.id }} .sl-rp__viewer-body {
    flex: 1;
    position: relative;
    min-height: 450px;
  }

  #shopify-section-{{ section.id }} .sl-rp__viewer-iframe {
    width: 100%;
    height: 100%;
    border: none;
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .sl-rp__viewer-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: #aaa;
    font-family: var(--font-body-family);
    font-size: 1.3rem;
  }

  #shopify-section-{{ section.id }} .sl-rp__viewer-empty[hidden] {
    display: none;
  }

  /* ── Mobile: stacked, cards on top, viewer below ── */
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sl-rp__tabs {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .sl-rp__tab {
      padding: 1.2rem 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.15);
    }

    #shopify-section-{{ section.id }} .sl-rp__tab:last-child {
      border-bottom: none;
    }

    #shopify-section-{{ section.id }} .sl-rp__tab::after {
      display: none;
    }

    #shopify-section-{{ section.id }} .sl-rp__tab--active {
      background-color: rgba(255,255,255,0.1);
    }

    #shopify-section-{{ section.id }} .sl-rp__viewer-body {
      min-height: 60vh;
    }

    #shopify-section-{{ section.id }} .sl-rp__viewer {
      margin-top: 1.5rem;
    }
  }

  /* ── Desktop: sidebar left, viewer right ── */
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .sl-rp__layout {
      flex-direction: row;
      gap: 2rem;
      padding: 0 {% if section.settings.full_width %}5rem{% else %}3rem{% endif %};
      margin-top: 2rem;
    }

    #shopify-section-{{ section.id }} .sl-rp__sidebar {
      width: 28%;
      flex-shrink: 0;
      max-height: 80vh;
      overflow-y: auto;
      padding-top: 0;
    }

    #shopify-section-{{ section.id }} .sl-rp__viewer {
      flex: 1;
      min-height: 80vh;
    }

    #shopify-section-{{ section.id }} .sl-rp__viewer-body {
      min-height: 0;
      flex: 1;
    }
  }
</style>

<script>
  (function() {
    var sectionId = '{{ section.id }}';

    function isMobile() {
      return /iPhone|iPad|iPod|Android/i.test(navigator.userAgent) || (window.innerWidth < 990);
    }

    function initTabs() {
      var tabs = document.querySelectorAll('[data-sl-rp-tab][data-section="' + sectionId + '"]');
      var panels = document.querySelectorAll('[data-sl-rp-panel][data-section="' + sectionId + '"]');

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          var target = this.getAttribute('data-sl-rp-tab');
          tabs.forEach(function(t) { t.classList.remove('sl-rp__tab--active'); });
          panels.forEach(function(p) { p.classList.remove('sl-rp__panel--active'); });
          this.classList.add('sl-rp__tab--active');
          var panel = document.querySelector('[data-sl-rp-panel="' + target + '"][data-section="' + sectionId + '"]');
          if (panel) panel.classList.add('sl-rp__panel--active');

          var viewer = document.querySelector('[data-sl-rp-viewer][data-section="' + sectionId + '"]');
          var iframe = viewer.querySelector('[data-sl-rp-iframe]');
          var titleEl = viewer.querySelector('[data-sl-rp-viewer-title]');
          var emptyEl = viewer.querySelector('[data-sl-rp-viewer-empty]');
          var actionsEl = viewer.querySelector('[data-sl-rp-viewer-actions]');
          iframe.src = '';
          titleEl.textContent = 'Select a document to view';
          emptyEl.hidden = false;
          actionsEl.style.display = 'none';
          viewer.classList.remove('sl-rp__viewer--active');

          var allCards = document.querySelectorAll('[data-sl-rp-open][data-section="' + sectionId + '"]');
          allCards.forEach(function(c) { c.classList.remove('sl-rp__card--active'); });

          var firstCard = panel ? panel.querySelector('[data-sl-rp-open]') : null;
          if (firstCard && !isMobile()) {
            firstCard.click();
          }
        });
      });
    }

    function initViewer() {
      var viewer = document.querySelector('[data-sl-rp-viewer][data-section="' + sectionId + '"]');
      if (!viewer) return;
      var iframe = viewer.querySelector('[data-sl-rp-iframe]');
      var titleEl = viewer.querySelector('[data-sl-rp-viewer-title]');
      var downloadBtn = viewer.querySelector('[data-sl-rp-download]');
      var newTabBtn = viewer.querySelector('[data-sl-rp-newtab]');
      var emptyEl = viewer.querySelector('[data-sl-rp-viewer-empty]');
      var actionsEl = viewer.querySelector('[data-sl-rp-viewer-actions]');

      function loadPdf(url, title) {
        titleEl.textContent = title;
        iframe.src = url;
        if (downloadBtn) downloadBtn.href = url;
        if (newTabBtn) newTabBtn.href = url;
        emptyEl.hidden = true;
        actionsEl.style.display = '';
        viewer.classList.add('sl-rp__viewer--active');
      }

      document.querySelectorAll('[data-sl-rp-open][data-section="' + sectionId + '"]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var url = this.getAttribute('data-pdf-url');
          var title = this.getAttribute('data-pdf-title');
          if (!url) {
            alert('No file URL found. Check that the metaobject entry has a file uploaded and Storefront API access is enabled.');
            return;
          }

          if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
            window.open(url, '_blank');
            return;
          }

          var allCards = document.querySelectorAll('[data-sl-rp-open][data-section="' + sectionId + '"]');
          allCards.forEach(function(c) { c.classList.remove('sl-rp__card--active'); });
          this.classList.add('sl-rp__card--active');

          loadPdf(url, title);
        });
      });

      var printBtn = viewer.querySelector('[data-sl-rp-print]');
      if (printBtn) {
        printBtn.addEventListener('click', function() {
          if (iframe.contentWindow) {
            iframe.contentWindow.focus();
            iframe.contentWindow.print();
          }
        });
      }

      if (!isMobile()) {
        var firstCard = document.querySelector('[data-sl-rp-panel--active] [data-sl-rp-open][data-section="' + sectionId + '"]')
          || document.querySelector('.sl-rp__panel--active [data-sl-rp-open][data-section="' + sectionId + '"]');
        if (firstCard) {
          var url = firstCard.getAttribute('data-pdf-url');
          var title = firstCard.getAttribute('data-pdf-title');
          if (url) {
            firstCard.classList.add('sl-rp__card--active');
            loadPdf(url, title);
          }
        }
      }
    }

    function init() {
      initTabs();
      initViewer();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    if (typeof Shopify !== 'undefined' && Shopify.designMode) {
      document.addEventListener('shopify:section:load', function(e) {
        if (e.detail.sectionId === sectionId) init();
      });
    }
  })();
</script>
{%- endif -%}

