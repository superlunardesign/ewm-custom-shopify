{% comment %}
  EWM Image Card Grid
  Grid of image cards with optional text overlay/below, buttons, scrolling marquee
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .sl-icg {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sl-icg {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="sl-icg" style="background-color: {{ section.settings.bg_color }};">
  <div class="sl-icg__container">
    {% if section.settings.heading != blank %}
      <h2 class="sl-icg__heading {{ section.settings.heading_size }}" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="sl-icg__grid-wrap">
        {% if section.settings.enable_marquee and section.settings.marquee_text != blank %}
          <div class="sl-icg__marquee" aria-hidden="true">
            <div class="sl-icg__marquee-track">
              {% for i in (1..10) %}
                <span class="sl-icg__marquee-item" style="color: {{ section.settings.marquee_color }}; font-size: {{ section.settings.marquee_size }}px; {% if section.settings.marquee_font == 'heading' %}font-family: var(--font-heading-family); font-weight: var(--font-heading-weight); font-style: var(--font-heading-style);{% else %}font-family: var(--font-body-family);{% endif %}">{{ section.settings.marquee_text }}</span>
              {% endfor %}
            </div>
          </div>

          <div class="sl-icg__marquee-v" aria-hidden="true">
            <div class="sl-icg__marquee-v-track">
              {% for i in (1..10) %}
                <span class="sl-icg__marquee-v-item" style="color: {{ section.settings.marquee_color }}; font-size: {{ section.settings.marquee_size }}px; {% if section.settings.marquee_font == 'heading' %}font-family: var(--font-heading-family); font-weight: var(--font-heading-weight); font-style: var(--font-heading-style);{% else %}font-family: var(--font-body-family);{% endif %}">{{ section.settings.marquee_text }}</span>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <div class="sl-icg__grid">
        {% for block in section.blocks %}
          <div class="sl-icg__card" {{ block.shopify_attributes }}>
            <div class="sl-icg__card-media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    sizes: '(min-width: 990px) calc(100vw / columns), (min-width: 750px) 50vw, 100vw',
                    widths: '375, 550, 750, 1000, 1200',
                    class: 'sl-icg__card-img',
                    loading: 'lazy'
                }}
              {% else %}
                <div class="sl-icg__card-placeholder">
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}

              {% if section.settings.text_position == 'overlay' %}
                {% if block.settings.card_heading != blank or block.settings.card_text != blank or section.settings.show_buttons and block.settings.button_text != blank %}
                  <div class="sl-icg__card-overlay">
                    <div class="sl-icg__card-overlay-content">
                      {% if block.settings.card_heading != blank %}
                        <h3 class="sl-icg__card-title">{{ block.settings.card_heading }}</h3>
                      {% endif %}
                      {% if block.settings.card_text != blank %}
                        <p class="sl-icg__card-desc">{{ block.settings.card_text }}</p>
                      {% endif %}
                      {% if section.settings.show_buttons and block.settings.button_text != blank %}
                        <a
                          {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% endif %}
                          class="sl-icg__card-btn sl-icg__card-btn--overlay"
                          style="color: {{ section.settings.button_text_color }}; border-color: {{ section.settings.button_border_color }}; font-size: {{ section.settings.button_font_size | times: 0.1 }}rem;"
                        >
                          {{ block.settings.button_text | escape }}
                        </a>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              {% endif %}
            </div>

            {% if section.settings.text_position == 'below' %}
              {% if block.settings.card_heading != blank or block.settings.card_text != blank %}
                <div class="sl-icg__card-text-below">
                  {% if block.settings.card_heading != blank %}
                    <h3 class="sl-icg__card-title sl-icg__card-title--below">{{ block.settings.card_heading }}</h3>
                  {% endif %}
                  {% if block.settings.card_text != blank %}
                    <p class="sl-icg__card-desc sl-icg__card-desc--below">{{ block.settings.card_text }}</p>
                  {% endif %}
                </div>
              {% endif %}

              {% if section.settings.show_buttons and block.settings.button_text != blank %}
                <div class="sl-icg__card-action">
                  <a
                    {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% endif %}
                    class="sl-icg__card-btn"
                    style="color: {{ section.settings.button_text_color }}; border-color: {{ section.settings.button_border_color }}; font-size: {{ section.settings.button_font_size | times: 0.1 }}rem;"
                  >
                    {{ block.settings.button_text | escape }}
                  </a>
                </div>
              {% endif %}
            {% endif %}

            {% if section.settings.text_position == 'none' and section.settings.show_buttons and block.settings.button_text != blank %}
              <div class="sl-icg__card-action">
                <a
                  {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% endif %}
                  class="sl-icg__card-btn"
                  style="color: {{ section.settings.button_text_color }}; border-color: {{ section.settings.button_border_color }}; font-size: {{ section.settings.button_font_size | times: 0.1 }}rem;"
                >
                  {{ block.settings.button_text | escape }}
                </a>
              </div>
            {% endif %}
          </div>
        {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .sl-icg {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sl-icg__container {
    position: relative;
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  #shopify-section-{{ section.id }} .sl-icg__heading {
    position: relative;
    z-index: 3;
    text-align: center;
    margin-bottom: 2rem;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
  }

  #shopify-section-{{ section.id }} .sl-icg__grid-wrap {
    position: relative;
  }

  /* ── Horizontal marquee (desktop) ── */
  #shopify-section-{{ section.id }} .sl-icg__marquee {
    position: absolute;
    top: calc(50% + {{ section.settings.marquee_offset_desktop | default: 0 }}px);
    left: -5rem;
    right: -5rem;
    transform: translateY(-50%);
    z-index: 1;
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
    display: none;
  }

  #shopify-section-{{ section.id }} .sl-icg__marquee-track {
    display: inline-flex;
    animation: slIcgScroll {{ section.settings.marquee_speed }}s linear infinite;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sl-icg__marquee-item {
    flex-shrink: 0;
    padding-right: 0.3em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @keyframes slIcgScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ── Vertical marquee (mobile) ── */
  #shopify-section-{{ section.id }} .sl-icg__marquee-v {
    position: absolute;
    top: 0;
    left: calc(-1.5rem + {{ section.settings.marquee_offset_mobile | default: 0 }}px);
    bottom: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    width: auto;
    display: block;
  }

  #shopify-section-{{ section.id }} .sl-icg__marquee-v-track {
    display: flex;
    flex-direction: column;
    animation: slIcgScrollV {{ section.settings.marquee_speed }}s linear infinite;
    writing-mode: vertical-lr;
    text-orientation: mixed;
  }

  #shopify-section-{{ section.id }} .sl-icg__marquee-v-item {
    flex-shrink: 0;
    padding-bottom: 0.3em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @keyframes slIcgScrollV {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }

  /* ── Card grid ── */
  #shopify-section-{{ section.id }} .sl-icg__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.card_gap }}px;
  }

  #shopify-section-{{ section.id }} .sl-icg__card {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .sl-icg__card-media {
    overflow: hidden;
    {% if section.settings.card_height_desktop > 0 %}
      height: {{ section.settings.card_height_desktop }}px;
    {% else %}
      aspect-ratio: {{ section.settings.image_ratio }};
    {% endif %}
    position: relative;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-icg__card-media {
      {% if section.settings.card_height_mobile > 0 %}
        height: {{ section.settings.card_height_mobile }}px;
        aspect-ratio: unset;
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} .sl-icg__card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .sl-icg__card-placeholder {
    background: rgba(0,0,0,0.05);
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .sl-icg__card-placeholder .placeholder-svg {
    width: 60%;
    height: auto;
    fill: currentColor;
    opacity: 0.3;
  }

  /* ── Overlay ── */
  #shopify-section-{{ section.id }} .sl-icg__card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    display: flex;
    align-items: {{ section.settings.overlay_vertical_align }};
    justify-content: center;
    padding: 1.5rem;
    transition: background 0.3s ease;
  }

  #shopify-section-{{ section.id }} .sl-icg__card-overlay-content {
    text-align: {{ section.settings.overlay_text_align }};
    width: 100%;
  }

  #shopify-section-{{ section.id }} .sl-icg__card-title {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: {{ section.settings.card_title_size }}px;
    line-height: 1.2;
    color: {{ section.settings.overlay_text_color }};
    margin: 0 0 0.5rem;
  }

  #shopify-section-{{ section.id }} .sl-icg__card-desc {
    font-family: var(--font-body-family);
    font-size: {{ section.settings.card_desc_size }}px;
    line-height: 1.5;
    color: {{ section.settings.overlay_text_color }};
    margin: 0;
  }

  /* ── Text below image ── */
  #shopify-section-{{ section.id }} .sl-icg__card-text-below {
    padding: 1rem 0;
  }

  #shopify-section-{{ section.id }} .sl-icg__card-title--below {
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .sl-icg__card-desc--below {
    color: {{ section.settings.card_text_below_color }};
  }

  /* ── Overlay button ── */
  #shopify-section-{{ section.id }} .sl-icg__card-btn--overlay {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.8rem 1.5rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    border: 1px solid;
    color: {{ section.settings.overlay_text_color }};
    border-color: {{ section.settings.overlay_text_color }};
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sl-icg__card-btn--overlay:hover {
    opacity: 0.7;
  }

  /* ── Button below ── */
  #shopify-section-{{ section.id }} .sl-icg__card-action {
    margin-top: {{ section.settings.button_gap }}px;
  }

  #shopify-section-{{ section.id }} .sl-icg__card-btn {
    display: block;
    text-align: center;
    padding: 1.2rem 1.5rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    border: 1px solid;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sl-icg__card-btn:hover {
    opacity: 0.7;
  }

  /* ── Mobile: vertical marquee on left, 1 col cards centered ── */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-icg__marquee {
      display: none !important;
    }

    {% if section.settings.enable_marquee and section.settings.marquee_text != blank %}
      #shopify-section-{{ section.id }} .sl-icg__marquee-v {
        display: block;
      }
    {% endif %}

    #shopify-section-{{ section.id }} .sl-icg__container {
      padding-left: 3rem;
      padding-right: 1.5rem;
    }

    #shopify-section-{{ section.id }} .sl-icg__grid {
      grid-template-columns: 1fr;
      max-width: 400px;
      margin: 0 auto;
    }
  }

  /* ── Tablet: 2 cols ── */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sl-icg__marquee {
      display: block;
    }

    #shopify-section-{{ section.id }} .sl-icg__marquee-v {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .sl-icg__container {
      padding-left: 3rem;
      padding-right: 3rem;
    }

    #shopify-section-{{ section.id }} .sl-icg__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Desktop: chosen column count ── */
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .sl-icg__marquee {
      display: block;
    }

    #shopify-section-{{ section.id }} .sl-icg__marquee-v {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .sl-icg__container {
      padding-left: 5rem;
      padding-right: 5rem;
    }

    #shopify-section-{{ section.id }} .sl-icg__grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "EWM Image Card Grid",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (Desktop)",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap Between Cards",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 5", "label": "Tall Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "card_height_desktop",
      "label": "Card Height — Desktop",
      "info": "Set to 0 to use aspect ratio instead",
      "min": 0,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_height_mobile",
      "label": "Card Height — Mobile",
      "info": "Set to 0 to match desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Optional Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Card Text & Buttons"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Card Text Position",
      "options": [
        { "value": "none", "label": "No Text (Image + Button Only)" },
        { "value": "overlay", "label": "Inside Image (Overlay)" },
        { "value": "below", "label": "Below Image" }
      ],
      "default": "none",
      "info": "Where card heading and description appear. Buttons follow the text when 'Below Image' is selected."
    },
    {
      "type": "checkbox",
      "id": "show_buttons",
      "label": "Show Buttons",
      "default": true
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card Title Size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_desc_size",
      "label": "Card Description Size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "card_text_below_color",
      "label": "Card Text Color (Below)",
      "default": "#4a4a4a",
      "info": "Only used when text position is 'Below Image'"
    },
    {
      "type": "header",
      "content": "Overlay Settings"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Darkness",
      "info": "Only applies when text is inside the image",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "Overlay Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "overlay_vertical_align",
      "label": "Overlay Vertical Alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "flex-end"
    },
    {
      "type": "select",
      "id": "overlay_text_align",
      "label": "Overlay Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "range",
      "id": "button_gap",
      "label": "Space Above Button",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button Text Size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#6b3a2a"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color",
      "default": "#6b3a2a"
    },
    {
      "type": "header",
      "content": "Scrolling Marquee"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Enable Scrolling Text Behind",
      "default": true
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee Text",
      "default": "SERVICES & TREATMENTS"
    },
    {
      "type": "range",
      "id": "marquee_size",
      "label": "Marquee Text Size",
      "min": 40,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "color",
      "id": "marquee_color",
      "label": "Marquee Text Color",
      "default": "#c4956a"
    },
    {
      "type": "select",
      "id": "marquee_font",
      "label": "Marquee Font",
      "options": [
        { "value": "heading", "label": "Heading Font" },
        { "value": "body", "label": "Body Font" }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee Speed",
      "info": "Higher = slower scroll",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 20
    },
    {
      "type": "range",
      "id": "marquee_offset_desktop",
      "label": "Marquee Vertical Offset (Desktop)",
      "info": "Shift marquee up (negative) or down (positive) from center",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "marquee_offset_mobile",
      "label": "Marquee Horizontal Offset (Mobile)",
      "info": "Shift vertical marquee left (negative) or right (positive)",
      "min": -200,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#f5f0eb"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
