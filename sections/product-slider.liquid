{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>

<style>
  #ProductSlider-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    border-top: {{ section.settings.border_top_width }}px solid {{ section.settings.border_top_color }};
    border-bottom: {{ section.settings.border_bottom_width }}px solid {{ section.settings.border_bottom_color }};
    width: 100%;
  }

  #ProductSlider-{{ section.id }} .product-slider__container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  #ProductSlider-{{ section.id }} .product-slider__header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: {{ section.settings.header_spacing }}px;
  }

  #ProductSlider-{{ section.id }} .product-slider__title {
    font-size: {{ section.settings.title_font_size }}px;
    color: {{ section.settings.title_color }};
    margin: 0 0 {{ section.settings.title_margin_bottom }}px 0;
    font-weight: {{ section.settings.title_font_weight }};
  }

  #ProductSlider-{{ section.id }} .product-slider__subtitle {
    font-size: {{ section.settings.subtitle_font_size }}px;
    color: {{ section.settings.subtitle_color }};
    margin: 0;
  }

  #ProductSlider-{{ section.id }} .product-slider-swiper {
    position: relative;
    overflow: hidden;
  }

  #ProductSlider-{{ section.id }} .product-slider-swiper .swiper-wrapper {
    opacity: 0;
    transition: opacity 0.3s ease;
    margin-bottom: {{ section.settings.slider_margin_bottom }}px;
  }

  #ProductSlider-{{ section.id }} .product-slider-swiper.swiper-initialized .swiper-wrapper {
    opacity: 1;
  }

  #ProductSlider-{{ section.id }} .product-slider__item {
    display: flex;
    flex-direction: column;
    text-align: center;
    padding-top: 0 !important;
  }

  #ProductSlider-{{ section.id }} .product-slider__image-wrapper {
    position: relative;
    padding-bottom: {{ section.settings.image_ratio }}%;
    margin-bottom: {{ section.settings.image_margin_bottom }}px;
    overflow: hidden;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  #ProductSlider-{{ section.id }} .product-slider__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  #ProductSlider-{{ section.id }} .product-slider__image--hover {
    opacity: 0;
  }

  #ProductSlider-{{ section.id }} .product-slider__item:hover .product-slider__image--main {
    opacity: 0;
  }

  #ProductSlider-{{ section.id }} .product-slider__item:hover .product-slider__image--hover {
    opacity: 1;
  }

  #ProductSlider-{{ section.id }} .product-slider__product-title {
    font-size: {{ section.settings.product_title_font_size }}px;
    color: {{ section.settings.product_title_color }};
    margin: 0 0 {{ section.settings.product_title_margin_bottom }}px 0;
    line-height: 1.2;
    text-decoration: none;
    display: block;
  }

  #ProductSlider-{{ section.id }} .product-slider__price {
    font-size: {{ section.settings.price_font_size }}px;
    color: {{ section.settings.price_color }};
    margin: 0 0 {{ section.settings.price_margin_bottom }}px 0;
  }

  #ProductSlider-{{ section.id }} .product-slider__price-compare {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 0.5rem;
  }

  #ProductSlider-{{ section.id }} .product-slider__quick-add {
    margin-top: auto;
  }

  #ProductSlider-{{ section.id }} .product-slider__add-button {
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    background-color: {{ section.settings.button_background }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    color: {{ section.settings.button_text_color }};
    font-size: {{ section.settings.button_font_size }}px;
    {% if section.settings.button_font == 'heading' %}
      font-family: var(--font-heading-family);
      font-weight: var(--font-heading-weight);
      font-style: var(--font-heading-style);
    {% else %}
      font-family: var(--font-body-family);
    {% endif %}
    border-radius: {{ section.settings.button_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    width: 100%;
  }

  #ProductSlider-{{ section.id }} .product-slider__add-button:hover {
    background-color: {{ section.settings.button_hover_background }};
    border-color: {{ section.settings.button_hover_border_color }};
    color: {{ section.settings.button_hover_text_color }};
  }

  #ProductSlider-{{ section.id }} .product-slider__view-all {
    text-align: center;
    margin-top: {{ section.settings.view_all_margin_top }}px;
  }

  #ProductSlider-{{ section.id }} .product-slider__view-all-button {
    padding: {{ section.settings.view_all_padding_y }}px {{ section.settings.view_all_padding_x }}px;
    background-color: {{ section.settings.view_all_background }};
    border: {{ section.settings.view_all_border_width }}px solid {{ section.settings.view_all_border_color }};
    color: {{ section.settings.view_all_text_color }};
    font-size: {{ section.settings.view_all_font_size }}px;
    border-radius: {{ section.settings.view_all_border_radius }}px;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
  }

  #ProductSlider-{{ section.id }} .product-slider__view-all-button:hover {
    background-color: {{ section.settings.view_all_hover_background }};
    border-color: {{ section.settings.view_all_hover_border_color }};
    color: {{ section.settings.view_all_hover_text_color }};
  }

  /* Navigation arrows - inherits global arrow styles from base.css */

  /* Pagination */
  #ProductSlider-{{ section.id }} .swiper-pagination-bullet {
    background: {{ section.settings.pagination_color }};
    opacity: 0.3;
  }

  #ProductSlider-{{ section.id }} .swiper-pagination-bullet-active {
    opacity: 1;
  }

  @media only screen and (max-width: 749px) {
    #ProductSlider-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #ProductSlider-{{ section.id }} .product-slider__title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }

    #ProductSlider-{{ section.id }} .product-slider__subtitle {
      font-size: {{ section.settings.subtitle_font_size_mobile }}px;
    }

    #ProductSlider-{{ section.id }} .product-slider__product-title {
      font-size: {{ section.settings.product_title_font_size_mobile }}px;
    }

    #ProductSlider-{{ section.id }} .product-slider__add-button {
      font-size: {{ section.settings.button_font_size_mobile }}px;
    }

    #ProductSlider-{{ section.id }} .product-slider__image-wrapper {
      border-radius: {{ section.settings.image_border_radius_mobile }}px;
    }
  }
</style>

<section id="ProductSlider-{{ section.id }}" class="product-slider-section">
  <div class="product-slider__container">
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="product-slider__header">
        {% if section.settings.title != blank %}
          <h2 class="product-slider__title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="product-slider__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="product-slider-swiper swiper" 
         dir="{{ section.settings.slider_direction }}"
         data-slides-desktop="{{ section.settings.slides_desktop }}"
         data-slides-tablet="{{ section.settings.slides_tablet }}"
         data-slides-mobile="{{ section.settings.slides_mobile }}"
         data-spacing="{{ section.settings.slide_spacing }}"
         data-autoplay="{{ section.settings.autoplay }}"
         data-autoplay-delay="{{ section.settings.autoplay_delay }}"
         data-loop="{{ section.settings.loop }}"
         data-pagination="{{ section.settings.show_pagination }}"
         data-navigation="{{ section.settings.show_arrows }}">
      <div class="swiper-wrapper">
        {% assign collection = collections[section.settings.collection] %}
        {% for product in collection.products limit: section.settings.products_limit %}
          <div class="product-slider__item swiper-slide">
            <a href="{{ product.url }}" class="product-slider__link">
              <div class="product-slider__image-wrapper">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 1000 }}"
                       srcset="{{ product.featured_image | image_url: width: 352 }} 352w,
                               {{ product.featured_image | image_url: width: 832 }} 832w,
                               {{ product.featured_image | image_url: width: 1000 }} 1000w"
                       width="1000"
                       height="{{ 1000 | divided_by: product.featured_image.aspect_ratio | round }}"
                       class="product-slider__image product-slider__image--main"
                       alt="{{ product.title }}"
                       loading="lazy">
                  
                  {% if product.images[1] and section.settings.show_hover_image %}
                    <img src="{{ product.images[1] | image_url: width: 1000 }}"
                         srcset="{{ product.images[1] | image_url: width: 352 }} 352w,
                                 {{ product.images[1] | image_url: width: 832 }} 832w,
                                 {{ product.images[1] | image_url: width: 1000 }} 1000w"
                         width="1000"
                         height="{{ 1000 | divided_by: product.images[1].aspect_ratio | round }}"
                         class="product-slider__image product-slider__image--hover"
                         alt="{{ product.title }}"
                         loading="lazy">
                  {% endif %}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'product-slider__image product-slider__image--main' }}
                {% endif %}
              </div>
            </a>
            
            {% if section.settings.show_product_title %}
              <a href="{{ product.url }}" class="product-slider__product-title">
                {{ product.title }}
              </a>
            {% endif %}
            
            {% if section.settings.show_price %}
              <p class="product-slider__price">
                {% if product.compare_at_price > product.price %}
                  <span class="product-slider__price-compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
                <span class="product-slider__price-current">{{ product.price | money }}</span>
              </p>
            {% endif %}
            
            {% if section.settings.show_quick_add %}
              <div class="product-slider__quick-add">
                <form action="/cart/add" method="post" enctype="multipart/form-data">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="product-slider__add-button">
                    {{ section.settings.add_to_cart_text }}
                  </button>
                </form>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
      
      {% if section.settings.show_arrows %}
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      {% endif %}
      
      {% if section.settings.show_pagination %}
        <div class="swiper-pagination"></div>
      {% endif %}
    </div>

    {% if section.settings.show_view_all and section.settings.collection != blank %}
      <div class="product-slider__view-all">
        <a href="{{ collections[section.settings.collection].url }}" class="product-slider__view-all-button">
          {{ section.settings.view_all_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.querySelector('#ProductSlider-{{ section.id }} .product-slider-swiper');
    if (!slider) return;
    
    const config = {
      slidesPerView: parseInt(slider.dataset.slidesMobile) || 2,
      spaceBetween: parseInt(slider.dataset.spacing) || 20,
      loop: slider.dataset.loop === 'true',
      autoplay: slider.dataset.autoplay === 'true' ? {
        delay: parseInt(slider.dataset.autoplayDelay) || 3000,
        disableOnInteraction: false
      } : false,
      pagination: slider.dataset.pagination === 'true' ? {
        el: '#ProductSlider-{{ section.id }} .swiper-pagination',
        clickable: true
      } : false,
      navigation: slider.dataset.navigation === 'true' ? {
        nextEl: '#ProductSlider-{{ section.id }} .swiper-button-next',
        prevEl: '#ProductSlider-{{ section.id }} .swiper-button-prev',
      } : false,
      breakpoints: {
        750: {
          slidesPerView: parseInt(slider.dataset.slidesTablet) || 3
        },
        1024: {
          slidesPerView: parseInt(slider.dataset.slidesDesktop) || 4
        }
      }
    };
    
    // Initialize Swiper with a delay to ensure styles are loaded
    setTimeout(() => {
      new Swiper(slider, config);
    }, 100);
  });
</script>

