{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-search.css' | asset_url | stylesheet_tag }}</noscript>

<style>
  /* ═══ EWM Search Results — PLP Card Style ═══ */

  .template-search__header {
    margin-bottom: 2rem;
  }

  .template-search__header .h2 {
    font-family: var(--font-body-family);
    font-weight: 400;
    font-size: 20px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gradient-base-accent-1);
    margin-bottom: 0;
  }

  .template-search__search {
    margin: 0 auto 2rem;
    max-width: 47.8rem;
  }

  .template-search__search .search {
    margin-top: 1.5rem;
  }

  .template-search__search .field__input {
    font-size: 16px;
    font-family: var(--font-body-family);
    border: 1px solid #ddd;
    border-radius: 0;
  }

  .template-search--empty {
    padding-bottom: 18rem;
  }

  @media screen and (min-width: 750px) {
    .template-search__header {
      margin-bottom: 3rem;
    }
  }

  .search__button .icon {
    height: 1.8rem;
  }

  /* Product Grid */
  #SLSearchGrid .sl-product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
  }

  @media screen and (min-width: 750px) {
    #SLSearchGrid .sl-product-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  @media screen and (min-width: 990px) {
    #SLSearchGrid .sl-product-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  #SLSearchGrid .grid__item {
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
  }

  /* Product Card */
  #SLSearchGrid .sl-product-card {
    background: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  /* Product Image */
  #SLSearchGrid .sl-product-image {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f5f5f3;
  }

  #SLSearchGrid .sl-product-image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  #SLSearchGrid .sl-product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    transition: transform 0.3s ease;
  }

  #SLSearchGrid .sl-product-card:hover .sl-product-image img {
    transform: scale(1.05);
  }

  #SLSearchGrid .sl-product-image .sl-placeholder {
    width: 100%;
    height: 100%;
    background: #f0ede8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #SLSearchGrid .sl-product-image .sl-placeholder svg {
    width: 60%;
    opacity: 0.3;
  }

  /* Badges */
  #SLSearchGrid .sl-badges {
    position: absolute;
    bottom: 12px;
    left: 12px;
    display: flex;
    flex-direction: row;
    gap: 6px;
    z-index: 2;
  }

  #SLSearchGrid .sl-badge {
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #ffffff;
  }

  #SLSearchGrid .sl-badge--sale { background: var(--gradient-base-accent-1); }
  #SLSearchGrid .sl-badge--soldout { background: #999; }

  /* Product Info */
  #SLSearchGrid .sl-product-info {
    padding: 15px;
  }

  #SLSearchGrid .sl-product-vendor {
    font-size: 10px;
    font-family: var(--font-body-family);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #8a8a7a;
    margin: 0 0 4px;
  }

  #SLSearchGrid .sl-product-title {
    font-size: 14px;
    font-weight: 400;
    font-family: var(--font-body-family);
    text-transform: capitalize;
    margin: 0 0 5px;
    color: #333;
    line-height: 1.3;
  }

  #SLSearchGrid .sl-product-title a {
    color: inherit;
    text-decoration: none;
  }

  #SLSearchGrid .sl-product-title a:hover {
    color: var(--gradient-base-accent-1);
  }

  /* Price */
  #SLSearchGrid .sl-product-price {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 0;
  }

  #SLSearchGrid .sl-price-current {
    font-size: 14px;
    color: var(--gradient-base-accent-1);
    font-weight: 500;
    font-family: var(--font-body-family);
  }

  #SLSearchGrid .sl-price-compare {
    font-size: 14px;
    color: #999;
    text-decoration: line-through;
    font-family: var(--font-body-family);
  }

  /* Star Rating */
  #SLSearchGrid .sl-star-rating {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0 0 4px;
    font-size: 13px;
    line-height: 1;
  }

  #SLSearchGrid .sl-star-rating .jdgm-prev-badge {
    display: flex !important;
    align-items: center;
    gap: 4px;
  }

  #SLSearchGrid .sl-star-rating .jdgm-star {
    color: var(--gradient-base-accent-1);
  }

  #SLSearchGrid .sl-star-rating .jdgm-prev-badge__text {
    display: none !important;
  }

  #SLSearchGrid .sl-star-rating .jdgm-prev-badge::after {
    content: "(" attr(data-number-of-reviews) ")";
    color: #333;
    font-size: 12px;
    opacity: 0.8;
  }

  /* Variant Options */
  #SLSearchGrid .sl-card-variants {
    padding: 0 15px;
  }

  #SLSearchGrid .sl-variant-options {
    margin-bottom: 0;
  }

  #SLSearchGrid .sl-option-group {
    margin-bottom: 8px;
  }

  #SLSearchGrid .sl-option-values {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  #SLSearchGrid .sl-size-btn {
    padding: 4px 12px;
    border: 1px solid var(--gradient-base-accent-1);
    background: transparent;
    color: var(--gradient-base-accent-1);
    border-radius: 20px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--font-body-family);
  }

  #SLSearchGrid .sl-size-btn:hover {
    border-color: #333;
  }

  #SLSearchGrid .sl-size-btn[data-selected="true"] {
    background: var(--gradient-base-accent-1);
    color: #ffffff;
    border-color: var(--gradient-base-accent-1);
  }

  #SLSearchGrid .sl-size-btn[data-unavailable="true"] {
    opacity: 0.4;
    cursor: not-allowed;
    position: relative;
  }

  #SLSearchGrid .sl-size-btn[data-unavailable="true"]::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: currentColor;
    transform: rotate(-15deg);
  }

  #SLSearchGrid .sl-color-swatch {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);
  }

  #SLSearchGrid .sl-color-swatch:hover {
    transform: scale(1.1);
  }

  #SLSearchGrid .sl-color-swatch[data-selected="true"] {
    border-color: var(--gradient-base-accent-1);
    box-shadow: 0 0 0 2px var(--gradient-base-accent-1);
  }

  #SLSearchGrid .sl-color-swatch[data-unavailable="true"] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  #SLSearchGrid .sl-more-options {
    font-size: 12px;
    color: #333;
    text-decoration: none;
    opacity: 0.8;
    padding: 4px 8px;
  }

  #SLSearchGrid .sl-more-options:hover {
    text-decoration: underline;
    opacity: 1;
  }

  /* ATC Button */
  #SLSearchGrid .sl-outside-button {
    padding: 8px 0 0;
  }

  #SLSearchGrid .sl-add-to-cart-btn {
    width: 100%;
    padding: 10px 30px;
    background: var(--gradient-base-accent-1);
    color: #ffffff;
    border: 1.5px solid var(--gradient-base-accent-1);
    border-radius: 0;
    font-size: 1.3rem;
    font-weight: 600;
    font-family: var(--font-body-family);
    line-height: 1.4;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: all 300ms linear;
  }

  #SLSearchGrid .sl-add-to-cart-btn:hover {
    opacity: 0.9;
  }

  #SLSearchGrid .sl-add-to-cart-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #SLSearchGrid .sl-oos-btn {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding: 10px 30px;
    background: #e5e5e5;
    border: 1.5px solid #ccc;
    border-radius: 0;
    font-size: 1.3rem;
    font-weight: 600;
    font-family: var(--font-body-family);
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #666;
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media screen and (max-width: 399px) {
    #SLSearchGrid .sl-add-to-cart-btn,
    #SLSearchGrid .sl-oos-btn {
      font-size: 11px;
      padding: 10px 10px;
      letter-spacing: 0.25px;
    }
  }

  /* Hide facets/sort bar */
  .template-search .facets-vertical-sort,
  .template-search .facets-wrapper {
    display: none;
  }

  .template-search .product-grid-container {
    width: 100%;
  }
</style>

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %} section-{{ section.id }}-padding">
<div class="page-width section-{{ section.id }}-padding isolate">
  <div class="template-search__header page-width center">
    {%- if search.performed -%}
      <h1 class="h2">{{ 'templates.search.title' | t }}</h1>
    {%- else -%}
      <h1 class="h2">{{ 'general.search.search' | t }}</h1>
    {%- endif -%}
    <div class="template-search__search">
      {%- if settings.predictive_search_enabled -%}
        <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
      {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search">
          <div class="field">
            <input
              class="search__input field__input"
              id="Search-In-Template"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.search' | t }}"
              {%- if settings.predictive_search_enabled -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results-list"
                aria-controls="predictive-search-results-list"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- endif -%}
            >

            <input name="options[prefix]" type="hidden" value="last">

            {%- if settings.predictive_search_enabled -%}
              <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
                <div class="predictive-search__loading-state">
                  <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                  </svg>
                </div>
              </div>

              <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
            {%- endif -%}

            <button type="submit" class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10.77 18.3C9.28 18.3 7.82 17.86 6.59 17.03C5.35 16.2 4.38 15.03 3.81 13.65C3.24 12.28 3.09 10.76 3.38 9.3C3.68 7.84 4.39 6.5 5.45 5.45C6.5 4.39 7.84 3.68 9.3 3.38C10.76 3.09 12.28 3.24 13.65 3.81C15.03 4.38 16.2 5.35 17.03 6.59C17.86 7.82 18.3 9.28 18.3 10.77C18.3 13.85 15.85 18.3 10.77 18.3Z" stroke="#333" stroke-width="1.5" fill="none"/>
              <path d="M20 20.75L15.34 16.4" stroke="#333" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        </form>
      {%- if settings.predictive_search_enabled -%}
        </predictive-search>
      {%- endif -%}

    </div>
    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p role="status" style="font-size:14px;color:#8a8a7a;margin-top:8px;">{{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}</p>
      {%- endif -%}
      {%- if search.results_count == 0 and search.filters == empty -%}
        <p role="status">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if search.performed and search.results_count > 0 -%}
    <div id="SLSearchGrid">
      {% paginate search.results by 24 %}
        <ul class="sl-product-grid" role="list">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' and item.tags contains 'acne-bootcamp-exclusive' -%}
              {%- continue -%}
            {%- endif -%}
            {%- if item.object_type == 'product' -%}
              {%- assign product_in_stock = false -%}
              {%- for variant in item.variants -%}
                {%- if variant.inventory_management == nil or variant.inventory_quantity > 0 or variant.inventory_policy == 'continue' -%}
                  {%- assign product_in_stock = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              <li class="grid__item">
                <div class="sl-card-wrapper" data-product-id="{{ item.id }}">
                  <div class="sl-product-card">
                    <div class="sl-product-image">
                      <div class="sl-badges">
                        {%- unless product_in_stock -%}
                          <span class="sl-badge sl-badge--soldout">Sold Out</span>
                        {%- elsif item.compare_at_price > item.price -%}
                          <span class="sl-badge sl-badge--sale">Sale</span>
                        {%- endunless -%}
                      </div>
                      <a href="{{ item.url }}">
                        {%- if item.featured_image -%}
                          <img src="{{ item.featured_image | img_url: '600x600' }}"
                               alt="{{ item.featured_image.alt | escape }}"
                               loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                               width="600"
                               height="600">
                        {%- else -%}
                          <div class="sl-placeholder">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 525 525" fill="none">
                              <path d="M262.5 180c-22.1 0-40 17.9-40 40s17.9 40 40 40 40-17.9 40-40-17.9-40-40-40zm0 64c-13.2 0-24-10.8-24-24s10.8-24 24-24 24 10.8 24 24-10.8 24-24 24z" fill="#ccc"/>
                              <path d="M350 148H175c-8.8 0-16 7.2-16 16v196c0 8.8 7.2 16 16 16h175c8.8 0 16-7.2 16-16V164c0-8.8-7.2-16-16-16zm0 212H175V164h175v196z" fill="#ccc"/>
                              <path d="M195 340l50-64.6 36.3 43.6L320 268l46 72H195z" fill="#ddd"/>
                            </svg>
                          </div>
                        {%- endif -%}
                      </a>
                    </div>

                    <div class="sl-product-info">
                      <h5 class="sl-product-vendor">{{ item.vendor }}</h5>
                      <h3 class="sl-product-title">
                        <a href="{{ item.url }}">{{ item.title }}</a>
                      </h3>
                      <div class="sl-star-rating">
                        <span class="jdgm-widget jdgm-preview-badge" data-id="{{ item.id }}">
                          {{ item.metafields.judgeme.badge }}
                        </span>
                      </div>
                      <div class="sl-product-price">
                        <span class="sl-price-current" data-product-price>{{ item.price | money }}</span>
                        {%- if item.compare_at_price > item.price -%}
                          <span class="sl-price-compare">{{ item.compare_at_price | money }}</span>
                        {%- endif -%}
                      </div>
                    </div>

                    {%- if item.has_only_default_variant == false and product_in_stock -%}
                    <div class="sl-card-variants">
                      <div class="sl-variant-options">
                        <script type="application/json" class="sl-variant-data">
                          {{ item.variants | json }}
                        </script>

                        {%- for option in item.options_with_values -%}
                          {%- assign option_name_lower = option.name | downcase -%}
                          {%- assign is_color = false -%}
                          {%- if option_name_lower contains 'color' or option_name_lower contains 'colour' -%}
                            {%- assign is_color = true -%}
                          {%- endif -%}

                          <div class="sl-option-group" data-option-type="{% if is_color %}color{% else %}size{% endif %}">
                            <div class="sl-option-values">
                              {%- assign max_visible = 6 -%}
                              {%- assign total_values = option.values.size -%}
                              {%- assign remaining = total_values | minus: max_visible -%}

                              {%- for value in option.values -%}
                                {%- if is_color -%}
                                  <button type="button"
                                          class="sl-color-swatch"
                                          data-option-position="{{ option.position }}"
                                          data-option-value="{{ value | escape }}"
                                          style="background-color: {{ value | handleize }};"
                                          title="{{ value }}"
                                          {% if forloop.first %}data-selected="true"{% endif %}>
                                  </button>
                                {%- else -%}
                                  {%- if forloop.index <= max_visible -%}
                                    <button type="button"
                                            class="sl-size-btn"
                                            data-option-position="{{ option.position }}"
                                            data-option-value="{{ value | escape }}"
                                            {% if forloop.first %}data-selected="true"{% endif %}>
                                      {{ value }}
                                    </button>
                                  {%- endif -%}
                                {%- endif -%}
                              {%- endfor -%}

                              {%- if remaining > 0 and is_color == false -%}
                                <a href="{{ item.url }}" class="sl-more-options">+{{ remaining }} More</a>
                              {%- endif -%}
                            </div>
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                    {%- endif -%}
                  </div>

                  <div class="sl-outside-button">
                    {%- if product_in_stock -%}
                      <button type="button"
                              class="sl-add-to-cart-btn"
                              data-variant-id="{{ item.selected_or_first_available_variant.id }}">
                        <span style="float:left">Add to Cart</span>
                        <span style="float:right" data-product-price>
                          <span class="sl-btn-price--full">{{ item.price | money }}</span>
                          <span class="sl-btn-price--short">{{ item.price | money | remove: '.00' }}</span>
                        </span>
                      </button>
                    {%- else -%}
                      <div class="sl-oos-btn" style="text-align:center">
                        <span>Sold Out</span>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {% endpaginate %}
    </div>
  {%- endif -%}
</div>
</div>

<script>
(function() {
  var searchGrid = document.getElementById('SLSearchGrid');
  if (!searchGrid) return;

  /* Mark unavailable variants */
  searchGrid.querySelectorAll('[data-product-id]').forEach(function(container) {
    var dataScript = container.querySelector('.sl-variant-data');
    if (!dataScript) return;
    try {
      var variants = JSON.parse(dataScript.textContent);
      container.querySelectorAll('.sl-size-btn, .sl-color-swatch').forEach(function(btn) {
        var pos = parseInt(btn.getAttribute('data-option-position'));
        var val = btn.getAttribute('data-option-value');
        var hasAvailable = variants.some(function(v) { return v['option' + pos] === val && v.available; });
        if (!hasAvailable) btn.setAttribute('data-unavailable', 'true');
      });
    } catch (e) {}
  });

  /* Variant selection */
  searchGrid.querySelectorAll('.sl-size-btn, .sl-color-swatch').forEach(function(button) {
    button.addEventListener('click', function() {
      if (this.getAttribute('data-unavailable') === 'true') return;

      var optionGroup = this.closest('.sl-option-group');
      var container = this.closest('[data-product-id]');
      var atcBtn = container.querySelector('.sl-add-to-cart-btn');
      var clicked = this;

      optionGroup.querySelectorAll('.sl-size-btn, .sl-color-swatch').forEach(function(b) { b.removeAttribute('data-selected'); });
      clicked.setAttribute('data-selected', 'true');

      var dataScript = container.querySelector('.sl-variant-data');
      if (!dataScript) return;

      try {
        var variants = JSON.parse(dataScript.textContent);
        var selected = {};
        container.querySelectorAll('.sl-size-btn[data-selected="true"], .sl-color-swatch[data-selected="true"]').forEach(function(s) {
          var p = s.getAttribute('data-option-position');
          var v = s.getAttribute('data-option-value');
          if (p && v) selected['option' + p] = v;
        });

        var match = variants.find(function(v) {
          return Object.keys(selected).every(function(k) { return v[k] === selected[k]; }) && v.available;
        });

        if (!match) {
          var clickedPos = clicked.getAttribute('data-option-position');
          var clickedVal = clicked.getAttribute('data-option-value');
          match = variants.find(function(v) { return v['option' + clickedPos] === clickedVal && v.available; });
        }

        if (match) {
          if (atcBtn) atcBtn.setAttribute('data-variant-id', match.id);

          container.querySelectorAll('[data-product-price]').forEach(function(el) {
            var formatted = Shopify.formatMoney ? Shopify.formatMoney(match.price) : '$' + (match.price / 100).toFixed(2);
            var fullEl = el.querySelector('.sl-btn-price--full');
            var shortEl = el.querySelector('.sl-btn-price--short');
            if (fullEl && shortEl) { fullEl.textContent = formatted; shortEl.textContent = formatted.replace('.00', ''); }
            else { el.textContent = formatted; }
          });

          var compareEl = container.querySelector('.sl-price-compare');
          if (compareEl && match.compare_at_price) {
            compareEl.textContent = Shopify.formatMoney ? Shopify.formatMoney(match.compare_at_price) : '$' + (match.compare_at_price / 100).toFixed(2);
            compareEl.style.display = 'inline';
          } else if (compareEl) { compareEl.style.display = 'none'; }

          if (match.featured_image && clicked.classList.contains('sl-color-swatch')) {
            var img = container.querySelector('.sl-product-image img');
            if (img) {
              var newUrl = match.featured_image.src.replace(/(_\d+x\d+)?(\.[^.]+)$/, '_600x600$2');
              img.src = newUrl;
              img.alt = match.featured_image.alt || match.name;
            }
          }
        }
      } catch (e) {}
    });
  });

  /* Add to Cart */
  var atcInProgress = false;
  searchGrid.querySelectorAll('.sl-add-to-cart-btn').forEach(function(button) {
    button.addEventListener('click', function() {
      if (atcInProgress) return;
      var variantId = this.getAttribute('data-variant-id');
      if (!variantId) return;

      atcInProgress = true;
      var originalContent = this.innerHTML;
      this.innerHTML = 'Adding...';
      this.disabled = true;

      var cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
      var formData = new FormData();
      formData.append('id', variantId);
      formData.append('quantity', '1');

      if (cart) {
        try {
          var sections = cart.getSectionsToRender().map(function(s) { return s.id; });
          formData.append('sections', sections.join(','));
          formData.append('sections_url', window.location.pathname);
          cart.setActiveElement(document.activeElement);
        } catch (e) {}
      }

      var btn = this;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: formData
      })
      .then(function(r) { return r.json(); })
      .then(function(response) {
        if (response.status) throw new Error(response.description || 'Error adding to cart');
        btn.innerHTML = 'Added!';
        if (cart) {
          if (cart.classList.contains('is-empty')) cart.classList.remove('is-empty');
          cart.renderContents(response);
        } else {
          window.location = '/cart';
          return;
        }
        setTimeout(function() { btn.innerHTML = originalContent; btn.disabled = false; atcInProgress = false; }, 1500);
      })
      .catch(function(error) {
        btn.innerHTML = originalContent;
        btn.disabled = false;
        atcInProgress = false;
        alert('Error: ' + error.message);
      });
    });
  });
})();
</script>

