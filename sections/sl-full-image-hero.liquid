{% comment %}
  Hero Section with Video/Photo Background
  Supports video and image backgrounds with opacity overlay
  Flexible content blocks for heading, subheading, body text, and buttons
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.desktop_height }}vh;
    min-height: {{ section.settings.min_height }}px;
    overflow: hidden;
    display: flex;
    align-items: {{ section.settings.vertical_alignment }};
    justify-content: center;
    background-color: {{ section.settings.overlay_color }};
  }

  /* Background Media Container */
  #shopify-section-{{ section.id }} .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: {{ section.settings.media_opacity | times: 0.01 }};
  }

  /* Video Background */
  #shopify-section-{{ section.id }} .hero-video {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: cover;
  }

  /* Image Background */
  #shopify-section-{{ section.id }} .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  /* Content Container */
  #shopify-section-{{ section.id }} .hero-content {
    position: relative;
    z-index: 2;
    max-width: {{ section.settings.content_width }}px;
    width: 100%;
    padding: 0 20px;
    text-align: {{ section.settings.text_alignment }};
  }

  /* Content Blocks Spacing */
  #shopify-section-{{ section.id }} .content-block {
    margin-bottom: {{ section.settings.block_spacing }}px;
  }

  #shopify-section-{{ section.id }} .content-block:last-child {
    margin-bottom: 0;
  }

  /* Typography Styles */
  #shopify-section-{{ section.id }} .hero-subheading {
    color: {{ section.settings.subheading_color }};
    font-size: {{ section.settings.subheading_size }}px;
    font-weight: {{ section.settings.subheading_weight }};
    text-transform: {{ section.settings.subheading_transform }};
    letter-spacing: {{ section.settings.subheading_spacing }}px;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .hero-heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_height }};
    text-transform: {{ section.settings.heading_transform }};
    margin: 0;
  }

  #shopify-section-{{ section.id }} .hero-body {
    color: {{ section.settings.body_color }};
    font-size: {{ section.settings.body_size }}px;
    line-height: {{ section.settings.body_line_height }};
    max-width: {{ section.settings.body_max_width }}px;
    margin: 0 auto;
  }

  /* Button Styles - Simplified like Scrapbook */
  #shopify-section-{{ section.id }} .hero-buttons {
    display: flex;
    gap: 15px;
    justify-content: {{ section.settings.text_alignment }};
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .hero-button {
    display: inline-block;
    padding: 10px 20px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    cursor: pointer;
    white-space: nowrap;
    {% if section.settings.button_border_radius > 0 %}
      border-radius: {{ section.settings.button_border_radius }}px;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .hero-button.primary {
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    border: 2px solid {{ section.settings.button_background }};
  }

  #shopify-section-{{ section.id }} .hero-button.primary:hover {
    background-color: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_text_color }};
    border-color: {{ section.settings.button_hover_background }};
  }

  #shopify-section-{{ section.id }} .hero-button.secondary {
    background-color: transparent;
    color: {{ section.settings.button_text_color }};
    border: 2px solid {{ section.settings.button_text_color }};
  }

  #shopify-section-{{ section.id }} .hero-button.secondary:hover {
    background-color: {{ section.settings.button_text_color }};
    color: {{ section.settings.overlay_color }};
    border-color: {{ section.settings.button_text_color }};
  }

  /* Animation */
  {% if section.settings.enable_animation %}
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    #shopify-section-{{ section.id }} .content-block {
      opacity: 0;
      animation: fadeInUp {{ section.settings.animation_duration }}ms ease-out forwards;
    }

    {% for i in (1..6) %}
      #shopify-section-{{ section.id }} .content-block:nth-child({{ i }}) {
        animation-delay: {{ section.settings.animation_delay | times: i }}ms;
      }
    {% endfor %}
  {% endif %}

  /* Parallax Effect */
  {% if section.settings.enable_parallax %}
    #shopify-section-{{ section.id }} .hero-background {
      transform: translateY(0);
      will-change: transform;
    }
  {% endif %}

  /* Mobile Styles */
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      height: {{ section.settings.mobile_height }}vh;
      min-height: {{ section.settings.mobile_min_height }}px;
    }

    #shopify-section-{{ section.id }} .hero-content {
      padding: 0 15px;
      text-align: {{ section.settings.mobile_text_alignment }};
    }

    #shopify-section-{{ section.id }} .hero-subheading {
      font-size: {{ section.settings.mobile_subheading_size }}px;
    }

    #shopify-section-{{ section.id }} .hero-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .hero-body {
      font-size: {{ section.settings.mobile_body_size }}px;
    }

    #shopify-section-{{ section.id }} .hero-button {
      font-size: 13px;
      padding: 8px 16px;
    }

    #shopify-section-{{ section.id }} .hero-buttons {
      justify-content: {{ section.settings.mobile_text_alignment }};
    }

    #shopify-section-{{ section.id }} .hero-image {
      object-position: {{ section.settings.mobile_image_position }};
    }
  }

  /* Tablet Styles */
  @media (min-width: 768px) and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .hero-heading {
      font-size: {{ section.settings.heading_size | times: 0.8 }}px;
    }

    #shopify-section-{{ section.id }} .hero-body {
      font-size: {{ section.settings.body_size | times: 0.9 }}px;
    }
  }
</style>

<div class="hero-background">
  {% if section.settings.background_type == 'video' and section.settings.background_video != blank %}
    <video class="hero-video" 
           autoplay 
           loop 
           muted 
           playsinline
           {% if section.settings.video_poster != blank %}
             poster="{{ section.settings.video_poster | image_url: width: 1920 }}"
           {% endif %}>
      <source src="{{ section.settings.background_video }}" type="video/mp4">
      {% if section.settings.video_poster != blank %}
        <img src="{{ section.settings.video_poster | image_url: width: 1920 }}" alt="">
      {% endif %}
    </video>
  {% elsif section.settings.background_image != blank %}
    <img class="hero-image" 
         src="{{ section.settings.background_image | image_url: width: 1920 }}" 
         alt="{{ section.settings.background_image.alt }}"
         loading="eager">
  {% endif %}
</div>

<div class="hero-content">
  {% for block in section.blocks %}
    <div class="content-block" {{ block.shopify_attributes }}>
      {% case block.type %}
        {% when 'subheading' %}
          {% if block.settings.text != blank %}
            {%- assign hero_subheading_tag = block.settings.subheading_tag | default: 'p' -%}
            <{{ hero_subheading_tag }} class="hero-subheading">{{ block.settings.text }}</{{ hero_subheading_tag }}>
          {% endif %}

        {% when 'heading' %}
          {% if block.settings.text != blank %}
            {%- assign hero_heading_tag = block.settings.heading_tag | default: 'h1' -%}
            <{{ hero_heading_tag }} class="hero-heading">{{ block.settings.text }}</{{ hero_heading_tag }}>
          {% endif %}

        {% when 'body' %}
          {% if block.settings.text != blank %}
            <div class="hero-body">
              {{ block.settings.text }}
            </div>
          {% endif %}

        {% when 'buttons' %}
          <div class="hero-buttons">
            {% if block.settings.button_1_text != blank %}
              <a href="{{ block.settings.button_1_link }}" 
                 class="hero-button primary">
                {{ block.settings.button_1_text }}
              </a>
            {% endif %}
            {% if block.settings.button_2_text != blank %}
              <a href="{{ block.settings.button_2_link }}" 
                 class="hero-button secondary">
                {{ block.settings.button_2_text }}
              </a>
            {% endif %}
          </div>
      {% endcase %}
    </div>
  {% endfor %}
</div>

{% if section.settings.enable_parallax %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const heroBackground = document.querySelector('#shopify-section-{{ section.id }} .hero-background');
    const parallaxSpeed = {{ section.settings.parallax_speed }};
    
    function updateParallax() {
      const scrolled = window.pageYOffset;
      const yPos = -(scrolled * parallaxSpeed / 100);
      heroBackground.style.transform = `translateY(${yPos}px)`;
    }
    
    if (window.innerWidth > 768) {
      window.addEventListener('scroll', updateParallax);
    }
    
    window.addEventListener('resize', function() {
      if (window.innerWidth <= 768) {
        window.removeEventListener('scroll', updateParallax);
        heroBackground.style.transform = 'translateY(0)';
      } else {
        window.addEventListener('scroll', updateParallax);
      }
    });
  });
</script>
{% endif %}

