{% comment %}
  Team Member Carousel Section
  
  Settings available in theme customizer:
  - section_heading: Section title
  - team_members: Array of team member blocks
  
  Block settings for each team member:
  - image: Team member photo
  - name: Team member name
  - title: Job title/credentials
  - bio: Biography text
  - book_text: CTA button text
  - book_url: CTA button link
{% endcomment %}

<section class="team-carousel-section">
  <div class="container">
    {% if section.settings.section_heading != blank %}
      <h2 class="team-carousel-title">{{ section.settings.section_heading }}</h2>
    {% endif %}
    
    <div class="team-carousel-wrapper">
      <div class="team-carousel" data-carousel="team">
        {% for block in section.blocks %}
          <div class="team-slide" data-slide="{{ forloop.index0 }}" {% if forloop.first %}data-active="true"{% endif %} {{ block.shopify_attributes }}>
            <div class="team-slide-inner">
              <div class="team-image-container">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | img_url: '600x600' }}" 
                       alt="{{ block.settings.name | escape }}" 
                       class="team-image">
                {% else %}
                  <div class="team-image-placeholder">
                    <svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="30" cy="30" r="30" fill="#f3f4f6"/>
                      <path d="M30 30c5.523 0 10-4.477 10-10s-4.477-10-10-10-10 4.477-10 10 4.477 10 10 10zm0 5c-6.667 0-20 3.333-20 10v5h40v-5c0-6.667-13.333-10-20-10z" fill="#9ca3af"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
              
              <div class="team-content">
                {% if block.settings.name != blank %}
                  <h3 class="team-name">{{ block.settings.name }}</h3>
                {% endif %}
                
                {% if block.settings.title != blank %}
                  <p class="team-title">{{ block.settings.title }}</p>
                {% endif %}
                
                {% if block.settings.bio != blank %}
                  <div class="team-bio">
                    {{ block.settings.bio | newline_to_br }}
                  </div>
                {% endif %}
                
                {% if block.settings.book_text != blank and block.settings.book_url != blank %}
                  <a href="{{ block.settings.book_url }}" class="team-cta-button">
                    {{ block.settings.book_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      
      {% if section.blocks.size > 1 %}
        <div class="team-carousel-navigation">
          <button class="nav-arrow nav-prev" aria-label="Previous team member">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg> PREVIOUS
          </button>
          
          <div class="team-carousel-pagination">
            {% for block in section.blocks %}
              <button class="pagination-dot" 
                      data-slide="{{ forloop.index0 }}" 
                      {% if forloop.first %}data-active="true"{% endif %}
                      aria-label="Go to slide {{ forloop.index }}">
              </button>
            {% endfor %}
          </div>
          
          <button class="nav-arrow nav-next" aria-label="Next team member">
            NEXT <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .team-carousel-section {
    padding: 2% 0;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .team-carousel-title {
    text-align: center;
    font-size: 24px;
    font-weight: 400;
    color: #333;
    margin-bottom: 50px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  
  .team-carousel-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  
  .team-carousel-navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
    order: 2;
  }
  
  .team-carousel {
    position: relative;
    overflow: hidden;
    touch-action: pan-y;
    order: 1;
  }
  
  .team-slide {
    display: none;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }
  
  .team-slide[data-active="true"] {
    display: block;
    opacity: 1;
  }
  
  .team-slide-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    min-height: 500px;
  }
  
  .team-image-container {
    position: relative;
  }
  
  .team-image {
    width: 100%;
    height: 500px;
    object-fit: cover;
    border-radius: 8px;
  }
  
  .team-image-placeholder {
    width: 100%;
    height: 500px;
    background-color: var(--gradient-base-background-3);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .team-content {
    padding: 10px 0;
  }
  
  .team-name {
    font-size: 48px;
    font-weight: 300;
    color: var(--color-base-accent-8);
    margin-bottom: 20px;
    line-height: 1.2;
  }
  
  .team-title {
    font-size: 16px;
    font-weight: 600;
    color: #333;
    margin-bottom: 30px;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  .team-bio {
    font-size: 16px;
    line-height: 1.6;
    color: #555;
    margin-bottom: 40px;
  }
  
  .team-bio p {
    margin-bottom: 15px;
  }
  
  .team-cta-button {
    display: inline-block;
    padding: 12px 0;
    color: var(--color-base-accent-8);
    text-decoration: none;
    font-weight: 400;
    font-size: 16px;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-bottom: 2px solid var(--color-base-accent-8);
    transition: all 0.3s ease;
  }
  
  .team-cta-button:hover {
    color: var(--color-base-accent-8);
    border-bottom-color: var(--color-base-accent-8);
  }
  
  .team-carousel-navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 40px;
  }
  
  .nav-arrow {
    background: none;
    border: none;
    color: var(--color-base-accent-8);
    cursor: pointer;
    padding: 8px;
    border-radius:5px;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: 40px;
  }
  
  .nav-arrow:hover {
    background-color: var(--gradient-base-background-3);
    color: var(--color-base-accent-8);
  }
  
  .nav-arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  
  .nav-arrow:disabled:hover {
    background: none;
    color: var(--color-base-accent-8);
  }
  
  .team-carousel-pagination {
    display: flex;
    justify-content: center;
    gap: 12px;
  }
  
  .pagination-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    background-color: #d1d5db;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }
  
  .pagination-dot[data-active="true"] {
    background-color: var(--color-base-accent-8);
  }
  
  .pagination-dot:hover {
    background-color: #9ca3af;
  }
  
  .pagination-dot[data-active="true"]:hover {
    background-color: var(--color-base-accent-8);
  }
  
  /* Mobile Styles */
  @media (max-width: 768px) {
    .team-carousel-section {
      padding: 40px 10px;
    }
    
    .container {
      padding: 0 15px;
    }
    
    .team-carousel-title {
      font-size: 20px;
      margin-bottom: 30px;
    }
    
    .team-carousel-wrapper {
      display: flex;
      flex-direction: column;
    }
    
    .team-carousel {
      order: 1;
      position: relative;
    }
    
    .team-carousel-navigation {
      position: absolute;
      top: 315px; /* Position below the 300px image + 15px margin */
      left: 0;
      right: 0;
      margin: 0;
      z-index: 10;
    }
    
    .team-slide-inner {
      grid-template-columns: 1fr;
      gap: 0;
      min-height: auto;
    }
    
    .team-image {
      height: 300px;
    }
    
    .team-image-placeholder {
      height: 300px;
    }
    
    .team-content {
      padding: 0;
      text-align: left;
      margin-top: 70px; /* Extra space to account for navigation */
    }
    
    .team-name {
      font-size: 36px;
      margin-bottom: 15px;
    }
    
    .team-title {
      font-size: 16px;
      margin-bottom: 20px;
    }
    
    .team-bio {
      font-size: 16px;
      margin-bottom: 30px;
    }
    
    .team-cta-button {
      font-size: 16px;
    }
    
    .team-image-container {
      order: 0;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // 1) Scope to the team carousel wrapper
  const wrapper = document.querySelector('.team-carousel-wrapper');
  if (!wrapper) return;

  const carousel = wrapper.querySelector('[data-carousel="team"]');
  const nav      = wrapper.querySelector('.team-carousel-navigation');
  const prevBtn  = nav   ? nav.querySelector('.nav-prev')  : null;
  const nextBtn  = nav   ? nav.querySelector('.nav-next')  : null;
  const dots     = nav   ? Array.from(nav.querySelectorAll('.pagination-dot')) : [];
  const slides   = Array.from(carousel.querySelectorAll('.team-slide'));

  let current = slides.findIndex(s => s.getAttribute('data-active') === 'true');
  if (current < 0) current = 0;

  function showSlide(idx) {
    slides.forEach((s, i) => s.setAttribute('data-active', i === idx));
    dots.forEach((d, i)   => d.setAttribute('data-active', i === idx));
    if (prevBtn) prevBtn.disabled = idx === 0;
    if (nextBtn) nextBtn.disabled = idx === slides.length - 1;
    current = idx;
  }

  function nextSlide() { showSlide(Math.min(current + 1, slides.length - 1)); }
  function prevSlide() { showSlide(Math.max(current - 1, 0)); }

  // arrows
  if (prevBtn) prevBtn.addEventListener('click', prevSlide);
  if (nextBtn) nextBtn.addEventListener('click', nextSlide);

  // dots
  dots.forEach((dot, i) => dot.addEventListener('click', () => showSlide(i)));

  // swipe (mobile)
  let startX, startY, isScrolling;
  carousel.addEventListener('touchstart', e => {
    startX = e.touches[0].clientX; startY = e.touches[0].clientY; isScrolling = null;
  }, { passive: true });
  carousel.addEventListener('touchmove', e => {
    if (startX == null) return;
    const dx = e.touches[0].clientX - startX;
    const dy = e.touches[0].clientY - startY;
    if (isScrolling == null) isScrolling = Math.abs(dy) > Math.abs(dx);
    if (!isScrolling && Math.abs(dx) > 10) e.preventDefault();
  }, { passive: false });
  carousel.addEventListener('touchend', e => {
    if (startX == null || isScrolling) { startX = null; return; }
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) dx > 0 ? prevSlide() : nextSlide();
    startX = null;
  }, { passive: true });

  // keyboard (only when focused/hovered within this wrapper)
  wrapper.addEventListener('keydown', e => {
    if (e.key === 'ArrowLeft')  prevSlide();
    if (e.key === 'ArrowRight') nextSlide();
  });

  // init
  showSlide(current);
});
</script>


{% schema %}
{
  "name": "Team Carousel",
  "tag": "section",
  "class": "team-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "YOUR ESTHETIC TEAM"
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team Member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Team Member Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Shannon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title/Credentials",
          "default": "FOUNDER | LICENSED ESTHETICIAN | CERTIFIED ACNE EXPERT"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Biography",
          "default": "Shannon knows what it's like to feel defeated by her skin.\nAs a teen, she dealt with painful breakouts, only to face red, flaky, reactive skin as an adult. After years of trial and error, she found herself frustrated and out of options.\nThat experience led her to become a Licensed Esthetician in 2021.\nHer goal is to help others feel confident in their skin by focusing on what it really needs, not trends or quick fixes.\nShannon brings education, empathy, and real-life experience to every treatment. She meets clients where they are and helps them build healthy, balanced skin with personalized support."
        },
        {
          "type": "text",
          "id": "book_text",
          "label": "CTA Button Text",
          "default": "BOOK WITH SHANNON"
        },
        {
          "type": "url",
          "id": "book_url",
          "label": "CTA Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Carousel",
      "blocks": [
        {
          "type": "team_member",
          "settings": {
            "name": "Shannon",
            "title": "FOUNDER | LICENSED ESTHETICIAN | CERTIFIED ACNE EXPERT",
            "bio": "Shannon knows what it's like to feel defeated by her skin.\nAs a teen, she dealt with painful breakouts, only to face red, flaky, reactive skin as an adult. After years of trial and error, she found herself frustrated and out of options.\nThat experience led her to become a Licensed Esthetician in 2021.\nHer goal is to help others feel confident in their skin by focusing on what it really needs, not trends or quick fixes.\nShannon brings education, empathy, and real-life experience to every treatment. She meets clients where they are and helps them build healthy, balanced skin with personalized support.",
            "book_text": "BOOK WITH SHANNON"
          }
        }
      ]
    }
  ]
}
