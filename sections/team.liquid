{% comment %}
  EWM Meet Your Team
  Overlap-style interactive team selector with portrait images
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .sl-team {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sl-team {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="sl-team color-{{ section.settings.color_scheme }} gradient">
  <div class="sl-team__container page-width">
    <div class="sl-team__grid{% if section.settings.image_position == 'right' %} sl-team__grid--reversed{% endif %}">

      <div class="sl-team__media" id="sl-team-media-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="sl-team__media-item{% if forloop.first %} sl-team__media-item--active{% endif %}" data-team-media="{{ forloop.index0 }}">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  widths: '375, 550, 750, 1000, 1200',
                  class: 'sl-team__img',
                  loading: 'lazy'
              }}
            {% else %}
              <div class="sl-team__placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="sl-team__content">
        <div class="sl-team__panels" id="sl-team-panels-{{ section.id }}">
          {% for block in section.blocks %}
            <div class="sl-team__panel{% if forloop.first %} sl-team__panel--active{% endif %}" data-team-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="sl-team__panel-top">
                <p class="sl-team__subheading">MEET</p>
                <h2 class="sl-team__name {{ section.settings.heading_size }}">{{ block.settings.name }}</h2>
                {% if block.settings.title != blank %}
                  <p class="sl-team__title">{{ block.settings.title }}</p>
                {% endif %}
              </div>

              {% if block.settings.bio != blank %}
                <div class="sl-team__bio">
                  {{ block.settings.bio | newline_to_br }}
                </div>
              {% endif %}

              {% if block.settings.book_url != blank %}
                <div class="sl-team__button-wrap">
                  <a href="{{ block.settings.book_url }}" class="button{% if section.settings.button_style == 'secondary' %} button--secondary{% endif %}">
                    {{ block.settings.book_text | default: 'BOOK NOW' | escape }}
                  </a>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        {% if section.blocks.size > 1 %}
          <button class="sl-team__next" id="sl-team-next-{{ section.id }}" type="button">
            Meet {{ section.blocks[1].settings.name }} &rarr;
          </button>
        {% endif %}
      </div>

    </div>
  </div>
</div>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var names = [{% for block in section.blocks %}'{{ block.settings.name | escape }}'{% unless forloop.last %},{% endunless %}{% endfor %}];
    var current = 0;

    function init() {
      var panels = document.getElementById('sl-team-panels-' + sectionId);
      var mediaWrap = document.getElementById('sl-team-media-' + sectionId);
      var nextBtn = document.getElementById('sl-team-next-' + sectionId);
      if (!panels) return;

      function show(idx) {
        current = idx;
        var items = panels.querySelectorAll('[data-team-index]');
        var medias = mediaWrap ? mediaWrap.querySelectorAll('[data-team-media]') : [];

        items.forEach(function(el) {
          el.classList.toggle('sl-team__panel--active', el.dataset.teamIndex === '' + idx);
        });

        medias.forEach(function(el) {
          el.classList.toggle('sl-team__media-item--active', el.dataset.teamMedia === '' + idx);
        });

        if (nextBtn && names.length > 1) {
          var nextIdx = (idx + 1) % names.length;
          nextBtn.innerHTML = 'Meet ' + names[nextIdx] + ' &rarr;';
        }
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          show((current + 1) % names.length);
        });
      }

      show(0);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    if (Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', function(e) {
        if (e.detail.sectionId === sectionId) init();
      });
      document.addEventListener('shopify:block:select', function(e) {
        if (e.detail.sectionId !== sectionId) return;
        var panels = document.getElementById('sl-team-panels-' + sectionId);
        if (!panels) return;
        var blocks = panels.querySelectorAll('[data-team-index]');
        blocks.forEach(function(el) {
          if (el.contains(e.target) || el === e.target) {
            var idx = parseInt(el.dataset.teamIndex, 10);
            current = idx;
            el.classList.add('sl-team__panel--active');
            var medias = document.querySelectorAll('#sl-team-media-' + sectionId + ' [data-team-media]');
            medias.forEach(function(m) {
              m.classList.toggle('sl-team__media-item--active', m.dataset.teamMedia === '' + idx);
            });
            var nextBtn = document.getElementById('sl-team-next-' + sectionId);
            if (nextBtn && names.length > 1) {
              var nextIdx = (idx + 1) % names.length;
              nextBtn.innerHTML = 'Meet ' + names[nextIdx] + ' &rarr;';
            }
          } else {
            el.classList.remove('sl-team__panel--active');
          }
        });
      });
    }
  })();
</script>

<style>
  {% if section.settings.enable_sticky %}
    #shopify-section-{{ section.id }} {
      position: sticky !important;
      top: 0;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .sl-team__container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  #shopify-section-{{ section.id }} .sl-team__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: stretch;
  }

  /* ── Image panel ── */
  #shopify-section-{{ section.id }} .sl-team__media {
    position: relative;
    overflow: hidden;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .sl-team__media-item {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sl-team__media-item:first-child {
    position: relative;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .sl-team__media-item--active {
    opacity: 1;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .sl-team__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position_x }}% {{ section.settings.image_position_y }}%;
  }

  #shopify-section-{{ section.id }} .sl-team__placeholder {
    background: rgb(var(--color-base-background-2));
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .sl-team__placeholder .placeholder-svg {
    width: 60%;
    height: auto;
    fill: currentColor;
    opacity: 0.3;
  }

  /* ── Content panel ── */
  #shopify-section-{{ section.id }} .sl-team__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.5rem;
    background-color: {{ section.settings.content_background }};
  }

  /* ── Panels ── */
  #shopify-section-{{ section.id }} .sl-team__panels {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .sl-team__panel {
    display: none;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .sl-team__panel--active {
    display: flex;
    animation: slTeamFadeIn-{{ section.id }} 0.4s ease forwards;
  }

  @keyframes slTeamFadeIn-{{ section.id }} {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Typography ── */
  #shopify-section-{{ section.id }} .sl-team__subheading {
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.subheading_color }};
    margin: 0 0 0.4rem;
  }

  #shopify-section-{{ section.id }} .sl-team__name {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    line-height: 1.15;
    margin: 0 0 0.6rem;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .sl-team__title {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ section.settings.subheading_color }};
    margin: 0 0 1.5rem;
    line-height: 1.4;
  }

  /* ── Bio with discreet scrollbar ── */
  #shopify-section-{{ section.id }} .sl-team__bio {
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin: 0 0 2rem;
    overflow-y: auto;
    flex: 1;
    min-height: 0;
    padding-right: 0.8rem;
  }

  #shopify-section-{{ section.id }} .sl-team__bio::-webkit-scrollbar {
    width: 4px;
  }

  #shopify-section-{{ section.id }} .sl-team__bio::-webkit-scrollbar-track {
    background: transparent;
  }

  #shopify-section-{{ section.id }} .sl-team__bio::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 2px;
  }

  #shopify-section-{{ section.id }} .sl-team__bio::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.3);
  }

  #shopify-section-{{ section.id }} .sl-team__bio {
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.15) transparent;
  }

  #shopify-section-{{ section.id }} .sl-team__bio p {
    margin-bottom: 1em;
  }

  #shopify-section-{{ section.id }} .sl-team__bio p:last-child {
    margin-bottom: 0;
  }

  /* ── Button ── */
  #shopify-section-{{ section.id }} .sl-team__button-wrap {
    margin-top: 0.5rem;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sl-team__button-wrap .button {
    width: 100%;
  }

  /* ── Meet Next link ── */
  #shopify-section-{{ section.id }} .sl-team__next {
    appearance: none;
    background: none;
    border: none;
    border-top: 1px solid {{ section.settings.select_border_color | default: '#ddd' }};
    padding: 1.4rem 0 0;
    margin-top: 1.5rem;
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    letter-spacing: 0.06em;
    color: {{ section.settings.heading_color }};
    cursor: pointer;
    text-align: left;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sl-team__next:hover {
    opacity: 0.7;
  }

  /* ═══ MOBILE ═══ */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-team__media {
      min-height: {{ section.settings.mobile_image_height }}px;
    }

    #shopify-section-{{ section.id }} .sl-team__bio {
      max-height: {{ section.settings.mobile_bio_max_height }}px;
    }
  }

  /* ═══ DESKTOP ═══ */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sl-team__container {
      padding-left: 5rem;
      padding-right: 5rem;
    }

    #shopify-section-{{ section.id }} .sl-team__grid {
      grid-template-columns: {{ section.settings.image_width }}fr {{ section.settings.content_width }}fr;
      grid-template-rows: minmax({{ section.settings.desktop_height }}px, auto);
    }

    #shopify-section-{{ section.id }} .sl-team__media {
      grid-column: 1;
      grid-row: 1;
    }

    #shopify-section-{{ section.id }} .sl-team__content {
      grid-column: 2;
      grid-row: 1;
      z-index: 1;
      padding: 3rem;
      align-self: stretch;
      margin-left: -{{ section.settings.overlap_amount }}px;
      margin-top: {{ section.settings.vertical_inset }}px;
      margin-bottom: {{ section.settings.vertical_inset }}px;
    }

    /* Reversed: image right, text left */
    #shopify-section-{{ section.id }} .sl-team__grid--reversed {
      grid-template-columns: {{ section.settings.content_width }}fr {{ section.settings.image_width }}fr;
    }

    #shopify-section-{{ section.id }} .sl-team__grid--reversed .sl-team__media {
      grid-column: 2;
      grid-row: 1;
    }

    #shopify-section-{{ section.id }} .sl-team__grid--reversed .sl-team__content {
      grid-column: 1;
      grid-row: 1;
      margin-left: 0;
      margin-right: -{{ section.settings.overlap_amount }}px;
    }

    #shopify-section-{{ section.id }} .sl-team__bio {
      max-height: {{ section.settings.desktop_bio_max_height }}px;
    }

    #shopify-section-{{ section.id }} .sl-team__button-wrap .button {
      width: auto;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .sl-team__content {
      padding: 4rem;
    }
  }
</style>

{% schema %}
{
  "name": "Team Carousel",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Name Size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra Large" }
      ],
      "default": "h0"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "info": "Image side on desktop. On mobile, image always appears above."
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop Min Height",
      "min": 400,
      "max": 900,
      "step": 25,
      "unit": "px",
      "default": 625
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile Image Height",
      "min": 250,
      "max": 600,
      "step": 25,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Image Focal Point (Horizontal)",
      "info": "0% = left, 50% = center, 100% = right",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Image Focal Point (Vertical)",
      "info": "0% = top, 50% = center, 100% = bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Overlap Layout"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image Column Width",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Column Width",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "overlap_amount",
      "label": "Overlap Amount",
      "info": "How far the content panel extends over the image",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "vertical_inset",
      "label": "Vertical Inset",
      "info": "Space above/below the content panel where the image peeks through",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Bio Scroll"
    },
    {
      "type": "range",
      "id": "desktop_bio_max_height",
      "label": "Desktop Bio Max Height",
      "info": "Bio text scrolls when it exceeds this height",
      "min": 150,
      "max": 500,
      "step": 25,
      "unit": "px",
      "default": 250
    },
    {
      "type": "range",
      "id": "mobile_bio_max_height",
      "label": "Mobile Bio Max Height",
      "min": 150,
      "max": 400,
      "step": 25,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "primary", "label": "Primary (Filled)" },
        { "value": "secondary", "label": "Secondary (Outline)" }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Section Background",
      "options": [
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Content Panel Background",
      "default": "#f5f0eb"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Name Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading / Title Color",
      "default": "#6b6b6b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Bio Text Color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "select_border_color",
      "label": "Divider Color",
      "default": "#ddd"
    },
    {
      "type": "header",
      "content": "Sticky Section"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Make section sticky",
      "info": "Section stays pinned while scrolling so the next section slides over it",
      "default": false
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team Member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "First Name",
          "default": "Shannon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title / Credentials",
          "default": "FOUNDER | LICENSED ESTHETICIAN"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Bio",
          "default": "Shannon knows what it's like to feel defeated by her skin.\n\nAs a teen, she dealt with painful breakouts, only to face red, flaky, reactive skin as an adult. After years of trial and error, she found herself frustrated and out of options.\n\nThat experience led her to become a Licensed Esthetician in 2021."
        },
        {
          "type": "text",
          "id": "book_text",
          "label": "Button Text",
          "default": "BOOK WITH SHANNON"
        },
        {
          "type": "url",
          "id": "book_url",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Carousel",
      "category": "Custom",
      "blocks": [
        {
          "type": "team_member",
          "settings": {
            "name": "Shannon",
            "title": "FOUNDER | LICENSED ESTHETICIAN | CERTIFIED ACNE EXPERT",
            "bio": "Shannon knows what it's like to feel defeated by her skin.\n\nAs a teen, she dealt with painful breakouts, only to face red, flaky, reactive skin as an adult. After years of trial and error, she found herself frustrated and out of options.\n\nThat experience led her to become a Licensed Esthetician in 2021.",
            "book_text": "BOOK WITH SHANNON"
          }
        }
      ]
    }
  ],
  "max_blocks": 10
}
{% endschema %}
