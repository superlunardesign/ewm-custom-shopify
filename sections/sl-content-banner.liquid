{%- style -%}
/* =========================================================
   SL CONTENT BANNER
   ========================================================= */

#shopify-section-{{ section.id }} {
  overflow: visible;
}

{%- assign img_opacity = section.settings.overlay_darkness | divided_by: 100.0 -%}

#shopify-section-{{ section.id }} .sl-cb {
  position: relative;
  padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  background: {{ section.settings.bg_color | default: '#1a1a1a' }};
}

@media (min-width: 750px) {
  #shopify-section-{{ section.id }} .sl-cb {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
}

/* Background image layer */
#shopify-section-{{ section.id }} .sl-cb__bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: {{ img_opacity }};
}

#shopify-section-{{ section.id }} .sl-cb__bg-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Video background */
#shopify-section-{{ section.id }} .sl-cb__video {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
  opacity: {{ img_opacity }};
}

#shopify-section-{{ section.id }} .sl-cb__video video,
#shopify-section-{{ section.id }} .sl-cb__video iframe {
  position: absolute;
  top: 50%;
  left: 50%;
  min-width: 100%;
  min-height: 100%;
  width: auto;
  height: auto;
  transform: translate(-50%, -50%);
  object-fit: cover;
}

/* Inner container */
#shopify-section-{{ section.id }} .sl-cb__inner {
  position: relative;
  z-index: 2;
}

#shopify-section-{{ section.id }} .sl-cb__inner--full-width {
  max-width: none;
  padding: 0 clamp(1.5rem, 3vw, 3rem);
}

/* Content wrapper */
#shopify-section-{{ section.id }} .sl-cb__content {
  display: flex;
  flex-direction: column;
  gap: 0;
  max-width: {{ section.settings.content_max_width | default: 800 }}px;
  {% case section.settings.content_alignment %}
    {% when 'left' %}
      align-items: flex-start;
      text-align: left;
      margin-right: auto;
    {% when 'right' %}
      align-items: flex-end;
      text-align: right;
      margin-left: auto;
    {% else %}
      align-items: center;
      text-align: center;
      margin: 0 auto;
  {% endcase %}
}

/* Block: Subheading */
#shopify-section-{{ section.id }} .sl-cb__subheading {
  font-family: {% if section.settings.subheading_font == 'heading' %}var(--font-heading-family){% else %}var(--font-body-family){% endif %};
  font-size: {{ section.settings.subheading_size | default: 16 }}px;
  font-weight: {{ section.settings.subheading_weight | default: '400' }};
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: {{ section.settings.text_color | default: '#f0e8d8' }};
  margin: 0 0 20px;
}

/* Block: Heading */
#shopify-section-{{ section.id }} .sl-cb__heading {
  font-family: var(--font-heading-family);
  font-style: var(--font-heading-style);
  font-weight: var(--font-heading-weight);
  color: {{ section.settings.text_color | default: '#f0e8d8' }};
  margin: 0 0 24px;
  line-height: 1.1;
  letter-spacing: normal;
  word-break: normal;
}

/* Block: Text */
#shopify-section-{{ section.id }} .sl-cb__text {
  font-family: var(--font-body-family);
  font-size: {{ section.settings.body_font_size | default: 16 }}px;
  line-height: 1.6;
  color: {{ section.settings.text_color | default: '#f0e8d8' }};
  margin: 0 0 24px;
  max-width: 100%;
}

#shopify-section-{{ section.id }} .sl-cb__text p {
  margin: 0 0 8px;
}

#shopify-section-{{ section.id }} .sl-cb__text p:last-child {
  margin-bottom: 0;
}

/* Block: Button */
#shopify-section-{{ section.id }} .sl-cb__button {
  margin-top: 8px;
}

#shopify-section-{{ section.id }} .sl-cb__button a,
#shopify-section-{{ section.id }} .sl-cb__button span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: {{ section.settings.button_padding_y | default: 14 }}px {{ section.settings.button_padding_x | default: 36 }}px;
  {% if section.settings.button_font == 'body' %}
    font-family: var(--font-body-family);
  {% else %}
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
  {% endif %}
  font-size: {{ section.settings.button_font_size | default: 14 }}px;
  font-weight: {{ section.settings.button_font_weight | default: '500' }};
  text-transform: {{ section.settings.button_text_transform | default: 'uppercase' }};
  letter-spacing: {{ section.settings.button_letter_spacing | default: 1 | times: 0.01 }}em;
  text-decoration: none;
  cursor: pointer;
  border-radius: {{ section.settings.button_border_radius | default: 0 }}px;
  transition: all 0.3s ease;
}

#shopify-section-{{ section.id }} .sl-cb__button a:hover,
#shopify-section-{{ section.id }} .sl-cb__button span:hover {
  opacity: {{ section.settings.button_hover_opacity | default: 85 | times: 0.01 }};
}

/* Spacer block */
#shopify-section-{{ section.id }} .sl-cb__spacer {
  display: block;
}

/* Fade-up animation */
{% if section.settings.enable_animation %}
  .js #shopify-section-{{ section.id }} .sl-cb__content {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity {{ section.settings.animation_duration | default: 600 }}ms ease-out, transform {{ section.settings.animation_duration | default: 600 }}ms ease-out;
  }

  .js #shopify-section-{{ section.id }} .sl-cb__content.sl-cb--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .no-js #shopify-section-{{ section.id }} .sl-cb__content,
  .shopify-design-mode #shopify-section-{{ section.id }} .sl-cb__content {
    opacity: 1;
    transform: none;
  }
{% endif %}
{%- endstyle -%}

{%- liquid
  assign gate_tag = section.settings.required_tag
  if gate_tag == blank and template.suffix == 'resource-portal'
    assign gate_tag = 'acne-bootcamp'
  endif
  assign gate_pass = true
  if gate_tag != blank
    assign gate_pass = false
    if customer
      for tag in customer.tags
        if tag == gate_tag
          assign gate_pass = true
          break
        endif
      endfor
    endif
  endif
-%}

{%- if gate_pass -%}
<div class="sl-cb">
  {%- if section.settings.bg_type == 'image' and section.settings.bg_image != blank -%}
    <div class="sl-cb__bg-image">
      <img src="{{ section.settings.bg_image | image_url: width: 2000 }}" alt="{{ section.settings.bg_image.alt | escape }}" loading="lazy">
    </div>
  {%- elsif section.settings.bg_type == 'video' -%}
    <div class="sl-cb__video">
      {%- if section.settings.bg_video != blank -%}
        {{ section.settings.bg_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
      {%- elsif section.settings.bg_video_url != blank -%}
        {%- assign video_url = section.settings.bg_video_url -%}
        {%- if video_url contains 'youtube.com' or video_url contains 'youtu.be' -%}
          {%- if video_url contains 'youtu.be' -%}
            {%- assign yt_id = video_url | split: 'youtu.be/' | last | split: '?' | first -%}
          {%- else -%}
            {%- assign yt_id = video_url | split: 'v=' | last | split: '&' | first -%}
          {%- endif -%}
          <iframe src="https://www.youtube.com/embed/{{ yt_id }}?autoplay=1&mute=1&loop=1&playlist={{ yt_id }}&controls=0&showinfo=0&modestbranding=1&playsinline=1" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
        {%- elsif video_url contains 'vimeo.com' -%}
          {%- assign vimeo_id = video_url | split: 'vimeo.com/' | last | split: '?' | first -%}
          <iframe src="https://player.vimeo.com/video/{{ vimeo_id }}?autoplay=1&muted=1&loop=1&background=1" frameborder="0" allow="autoplay" allowfullscreen></iframe>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="sl-cb__inner {% if section.settings.full_width %}sl-cb__inner--full-width{% else %}page-width{% endif %}">
    <div class="sl-cb__content"{% if section.settings.enable_animation %} data-sl-cb-animate{% endif %}>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subheading' -%}
            {%- if block.settings.text != blank -%}
              <p class="sl-cb__subheading" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- endif -%}

          {%- when 'heading' -%}
            {%- if block.settings.text != blank -%}
              {%- assign cb_heading_tag = block.settings.heading_tag | default: 'h2' -%}
              <{{ cb_heading_tag }} class="sl-cb__heading {{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</{{ cb_heading_tag }}>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="sl-cb__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'button' -%}
            {%- if block.settings.text != blank -%}
              <div class="sl-cb__button" {{ block.shopify_attributes }}>
                {%- assign btn_bg = block.settings.button_bg_color | default: 'transparent' -%}
                {%- assign btn_text = block.settings.button_text_color | default: section.settings.text_color | default: '#f0e8d8' -%}
                {%- assign btn_border = block.settings.button_border_color | default: btn_text -%}
                {%- if block.settings.style == 'primary' -%}
                  {%- assign btn_style = 'background: var(--gradient-base-accent-1); color: #fff; border: 1.5px solid var(--gradient-base-accent-1);' -%}
                {%- elsif block.settings.style == 'secondary' -%}
                  {%- assign btn_style = 'background: transparent; color: ' | append: btn_text | append: '; border: 1.5px solid ' | append: btn_text | append: ';' -%}
                {%- else -%}
                  {%- assign btn_style = 'background: ' | append: btn_bg | append: '; color: ' | append: btn_text | append: '; border: 1.5px solid ' | append: btn_border | append: ';' -%}
                {%- endif -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" style="{{ btn_style }}">{{ block.settings.text }}</a>
                {%- else -%}
                  <span style="{{ btn_style }}">{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'spacer' -%}
            <div class="sl-cb__spacer" style="height: {{ block.settings.height }}px;" {{ block.shopify_attributes }}></div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% if section.settings.enable_animation %}
<script>
  (function() {
    var targets = document.querySelectorAll('#shopify-section-{{ section.id }} [data-sl-cb-animate]');
    if (!targets.length) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('sl-cb--visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    targets.forEach(function(t) { observer.observe(t); });
  })();
</script>
{% endif %}
{%- endif -%}

