    "sl_custom_faq_ppAhzx": {
      "type": "sl-custom-faq",
      "blocks": {
        "faq_item_LWFRij": {
          "type": "faq_item",
          "settings": {
            "question": "I'm nervous about discomfort - What do you recommend?",
            "answer": "<p>We get it! Many of our clients mention this being the least uncomfortable waxing experience they've had – but if you're still worried, <strong>we recommend taking an Ibuprofen 30-40 minutes before your appointment</strong></p>"
          }
        },
        "faq_item_KtX7dR": {
          "type": "faq_item",
          "settings": {
            "question": "Can I still exercise or play sports?",
            "answer": "<p>No – <strong>Avoid swimming and exercising for 24-48 hours post-wax</strong>. Even though it is popular to get waxed before leaving for vacation, <strong>we advise getting waxed 2-3 days before you leave town.</strong></p>"
          }
        },
        "faq_item_8nXf9X": {
          "type": "faq_item",
          "settings": {
            "question": "How many waxes should I plan to get before my wedding?",
            "answer": "<p>We recommend 3 waxes so your skin is as comfortable and smooth as possible before your wedding date.</p>"
          }
        },
        "faq_item_WkzBt6": {
          "type": "faq_item",
          "settings": {
            "question": "How many waxes should I plan to get before my vacation?",
            "answer": "<p>We recommend getting waxed 2–3× beforehand (a little stubble after the first wax is normal because of hair growth cycles).</p>"
          }
        },
        "faq_item_7cwzea": {
          "type": "faq_item",
          "settings": {
            "question": "Can I get waxed on my period?",
            "answer": "<p>YES! We wax ladies on their periods every day. Please use a fresh tampon, disc, or an emptied cup before arrival. <strong>We also have tampons available for you in the bathroom.</strong></p>"
          }
        },
        "faq_item_MJGhNK": {
          "type": "faq_item",
          "settings": {
            "question": "Should I dress a specific way for my waxing appointment?",
            "answer": "<p>Yes, please wear loose fitting clothing to your appointment and plan to for the rest of the day. <br/>Avoid lace and spandex.<br/><strong>Cotton is best.</strong></p>"
          }
        },
        "faq_item_94aHPJ": {
          "type": "faq_item",
          "settings": {
            "question": "How painful is Brazilian waxing really?",
            "answer": "<p>While everyone's pain tolerance is different, most clients say it's not nearly as bad as they expected! The first time is usually the most uncomfortable, but it gets easier with each visit as your hair becomes finer. Our gentle technique and premium hard wax minimize discomfort, and the whole process takes just 15-20 minutes. The smooth results for 4-5 weeks are absolutely worth those few minutes!</p>"
          }
        },
        "faq_item_GPcWJw": {
          "type": "faq_item",
          "settings": {
            "question": "How do I book an appointment?",
            "answer": "<p>You can book an appointment through our online booking system by clicking the 'Book Now' button, or you can text us directly at 815-332-0918</p>"
          }
        },
        "faq_item_DiArcH": {
          "type": "faq_item",
          "settings": {
            "question": "How do I prevent ingrown hairs?",
            "answer": "<p>Prevention is key! Start gently exfoliating 48 hours after your wax, 2-3 times per week. Keep the area moisturized daily, wear loose cotton underwear when possible, and avoid tight clothing immediately after waxing. We'll provide you with specific aftercare instructions and recommend products that actually work. Most clients see a dramatic reduction in ingrowns when they follow our routine.</p>"
          }
        },
        "faq_item_HKPkTw": {
          "type": "faq_item",
          "settings": {
            "question": "What is your cancellation policy?",
            "answer": "<p>Appointments canceled or rescheduled with less than 48 hours notice are subject to a cancellation fee of 35% of the scheduled service. No-shows will be charged 100% of the scheduled service. </p>"
          }
        },
        "faq_item_kPgwxQ": {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer gift cards?",
            "answer": "<p>Yes! We offer both physical and digital gift cards in various denominations. They make perfect gifts for any occasion.</p>"
          }
        },
        "faq_item_tGYTxD": {
          "type": "faq_item",
          "settings": {
            "question": "Is Brazilian waxing worth the cost?",
            "answer": "<p>Absolutely! When you calculate the time and money spent on razors, shaving cream, and dealing with razor burn and ingrowns, professional waxing is actually cost-effective. Plus, you can't put a price on the confidence of being smooth for weeks, the reduction in hair growth over time, and healthier skin overall. Most clients say they wish they'd started sooner!</p>"
          }
        },
        "faq_item_UewjjT": {
          "type": "faq_item",
          "settings": {
            "question": "What are your business hours?",
            "answer": "<p>Monday through Friday: 9:00 AM to 8:00 PM, Saturday: 9:00 AM to 1:00 PM, Closed Sundays. These hours are subject to change for holidays.</p>"
          }
        }
      },
