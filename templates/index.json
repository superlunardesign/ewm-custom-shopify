    "team_876xbc": {
      "type": "team",
      "blocks": {
        "team_member_n8Rkin": {
          "type": "team_member",
          "settings": {
            "image": "shopify://shop_images/BrandingPhotography-C_Mae-5312.jpg",
            "name": "Shannon",
            "title": "FOUNDER | LICENSED ESTHETICIAN | CERTIFIED ACNE EXPERT",
            "bio": "Shannon knows what it’s like to feel defeated by her skin. \n\nAs a teen, she dealt with painful breakouts, only to face red, flaky, reactive skin as an adult. After years of trial and error, she found herself frustrated and out of options.\n\nThat experience led her to become a Licensed Esthetician in 2021. \n\nHer goal is to help others feel confident in their skin by focusing on what it really needs, not trends or quick fixes.\n\nShannon brings education, empathy, and real-life experience to every treatment. She meets clients where they are and helps them build healthy, balanced skin with personalized support.",
            "book_text": "BOOK WITH SHANNON",
            "book_url": "https://booking.mangomint.com/314399"
          }
        },
        "team_member_BxtzQj": {
          "type": "team_member",
          "settings": {
            "image": "shopify://shop_images/BrandingPhotography-C_Mae-5682.jpg",
            "name": "Yanelli",
            "title": "Licensed Esthetician | Certified Acne Expert",
            "bio": "Yanelli’s passion for skincare started at a young age. She graduated from Esthetics School in 2021 and has been dedicated ever since to helping others feel confident, informed, and excited about their skin.\n\nShe loves carving out time for self-care and believes that taking care of your skin is not just about how it looks, but how it makes you feel. For Yanelli, there is nothing better than feeling confident in your own skin and helping others feel the same way.\n\nIn the treatment room, Yanelli brings a fun, uplifting energy. She is passionate about creating an environment where clients can learn about their skin, build healthy habits, and enjoy the process of transformation. Whether it is your first facial or brazilian wax, she is here to support you every step of the way.\n\nYanelli’s availability:\nMonday & Tuesday 1–8 | Wednesday & Thursday 9–4 | Select Saturdays 9–1",
            "book_text": "BOOK WITH SHANNON",
            "book_url": ""
          }
        },
        "team_member_ti8aCD": {
          "type": "team_member",
          "settings": {
            "image": "shopify://shop_images/BrandingPhotography-C_Mae-5894.jpg",
            "name": "Autumn",
            "title": "Licensed Esthetician",
            "bio": "Autumn is a licensed esthetician with a warm, calming presence and a deep love for skincare. Inspired by her grandmother’s beauty business and her own journey with acne and skin sensitivity, Autumn found her calling in helping others feel seen, supported, and confident in their skin.\n\nShe’s especially passionate about chemical peels and brow waxing, two treatments she believes deliver powerful and visible results. Whether you’re struggling with breakouts or simply need a space to unwind, Autumn brings a grounded, gentle energy to every service.\n\nShe’s found that this work has helped her grow in ways she never expected. Her goal is simple: to offer each client a little peace, a little glow, and a whole lot of care.\n\nAutumn’s availability:\nTuesday 9-4 | Wednesday 12-7 | Thursday 12-7 | Friday 9-4 | Select Saturdays 9–1",
            "book_text": "BOOK WITH SHANNON",
            "book_url": ""
          }
        }
      },
