    "sl_custom_faq_r7Q6ht": {
      "type": "sl-custom-faq",
      "blocks": {
        "faq_item_knxa63": {
          "type": "faq_item",
          "settings": {
            "question": "What do I need for my virtual appointment?",
            "answer": "<p>All you need is a device with Zoom (computer, tablet, or phone), good lighting so we can see your skin clearly, and a quiet space where we can talk. We'll send you the Zoom link before your appointment.</p>"
          }
        },
        "faq_item_qjMHfp": {
          "type": "faq_item",
          "settings": {
            "question": "How do virtual skin consultations work?",
            "answer": "<p>We meet via Zoom for your scheduled appointment time. We'll do a deep dive into your skin, go over all your skincare questions, and educate you on how the skin functions. After your consultation, products selected based on your skin goals will be shipped directly to you with detailed instructions. A complimentary virtual follow-up will be booked at your appointment.</p>"
          }
        },
        "faq_item_PzXEKn": {
          "type": "faq_item",
          "settings": {
            "question": "Which consultation should I book?",
            "answer": "<p>If your primary concern is acne, book the Virtual Acne Bootcamp Consultation ($65/45 min). For all other skin concerns — dry skin, oily or combo skin, aging skin, and more — the Virtual Skin Consultation ($50/30 min) is the right choice for you.</p>"
          }
        },
        "faq_item_GmWhMf": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to purchase products?",
            "answer": "<p>Products are recommended based on your specific skin goals and are shipped directly to you. While purchasing products isn't technically required, using the right products is essential to seeing results. We'll never recommend anything you don't need.</p>"
          }
        },
        "faq_item_PGh67J": {
          "type": "faq_item",
          "settings": {
            "question": "What's included in the follow-up?",
            "answer": "<p>A complimentary virtual follow-up is booked at your initial appointment. This gives us a chance to check in on your progress, see how your skin is responding to your new routine, answer any questions that have come up, and make adjustments as needed.</p>"
          }
        },
        "faq_item_XkqtLR": {
          "type": "faq_item",
          "disabled": true,
          "settings": {
            "question": "When will I see results from my chemical peel?",
            "answer": "<p>You'll notice an immediate glow after your first chemical peel treatment. Over the following days, your skin will continue to improve as cell turnover accelerates. For concerns like dark spots, fine lines, and texture issues, visible improvement typically continues for 2-4 weeks after each treatment, with cumulative benefits building over your peel series.</p>"
          }
        },
        "faq_item_P6KPXe": {
          "type": "faq_item",
          "disabled": true,
          "settings": {
            "question": "What's the difference between professional chemical peels and drugstore peels?",
            "answer": "<p>Professional PCA chemical peels use higher concentrations of active ingredients that simply aren't available over the counter. More importantly, we custom-blend each peel for your specific skin — combining different acids and ingredients to target your unique concerns. Drugstore peels are one-size-fits-all; ours are one-of-a-kind, just like your skin.</p>"
          }
        },
        "faq_item_RJtP6A": {
          "type": "faq_item",
          "settings": {
            "question": "Can I do virtual if I live near McHenry?",
            "answer": "<p>Absolutely! Virtual consultations are a great option for those local who cannot make it in — whether it's due to a busy schedule, transportation, or simply preferring the convenience of meeting from home.</p>"
          }
        }
      },
