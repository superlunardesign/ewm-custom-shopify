{%- comment -%}
  SL Notify Me form — back-in-stock notification.
  Shows when the product (first variant) is unavailable.
  - Logged-in customers: single "Notify Me" button (email auto-filled).
  - Guests: first name + email fields + submit.
  - ?notify=true in URL auto-scrolls to this form.
  - Logged-in customers who already signed up see a "signed up" banner
    with a link to their notification settings.
{%- endcomment -%}

{%- unless product.available -%}
{%- comment -%} Check customer tags for server-side signed-up state {%- endcomment -%}
{%- assign bis_tag = 'bis:' | append: product.handle -%}
{%- assign bis_tagged = false -%}
{%- if customer and customer.tags contains bis_tag -%}
  {%- assign bis_tagged = true -%}
{%- endif -%}

<div class="sl-notify-form" id="sl-notify-form"
     data-product-handle="{{ product.handle }}"
     data-product-title="{{ product.title | escape }}"
     data-product-image="{{ product.featured_image | image_url: width: 200 }}"
     data-product-url="{{ product.url }}"
     data-product-id="{{ product.id }}"
     data-variant-id="{{ product.selected_or_first_available_variant.id | default: product.variants.first.id }}"
     data-variant-title="{{ product.selected_or_first_available_variant.title | default: product.variants.first.title | escape }}"
     {%- if customer %}data-customer-id="{{ customer.id }}"{% endif %}
     {%- if customer %}data-customer-email="{{ customer.email | escape }}"{% endif %}
     {%- if bis_tagged %}data-bis-tagged="true"{% endif %}>

  {%- comment -%} "Already signed up" banner — shown via Liquid tag check or JS localStorage {%- endcomment -%}
  {%- if customer -%}
    <div class="sl-notify-signed-up" id="sl-notify-signed-up" style="{% unless bis_tagged %}display:none;{% endunless %}">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <div>
        <p>You're signed up to be notified when this product is back in stock.</p>
        <a href="/pages/notification-settings" class="sl-notify-settings-link">Manage notification settings</a>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Standard form — hidden when already signed up (via tag or JS) {%- endcomment -%}
  <div id="sl-notify-form-inner" {% if bis_tagged %}style="display:none;"{% endif %}>
    <div id="sl-notify-success-msg" style="display:none;">
      <div class="sl-notify-success">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <div>
          <p>We'll notify you when this product is back in stock!</p>
          {%- if customer -%}
            <a href="/pages/notification-settings" class="sl-notify-settings-link">Manage notification settings</a>
          {%- else -%}
            <p class="sl-notify-account-cta"><a href="/account/register?return_url={{ product.url | url_encode }}">Create an account</a> to manage your notifications across devices.</p>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div id="sl-notify-form-body">
      <div class="sl-notify-header">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <span>Notify Me When Available</span>
      </div>

      <div id="sl-notify-error" class="sl-notify-error" style="display:none;">
        <p>Something went wrong. Please try again.</p>
      </div>

      {%- if customer -%}
        {%- comment -%} Logged-in: auto-fill everything, just show button {%- endcomment -%}
        <button type="button" id="sl-notify-submit-btn" class="sl-notify-submit sl-notify-submit--full">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          Notify Me
        </button>
      {%- else -%}
        {%- comment -%} Guest: show email field {%- endcomment -%}
        <div class="sl-notify-fields">
          <input
            type="email"
            id="sl-notify-email"
            placeholder="Email address"
            class="sl-notify-input"
            required
          >
        </div>
        <button type="button" id="sl-notify-submit-btn" class="sl-notify-submit">
          Notify Me
        </button>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endunless -%}

<style>
  .sl-notify-form {
    margin-top: 16px;
    padding: 20px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    background: #fafafa;
  }

  .sl-notify-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading-family);
    font-size: 16px;
    font-weight: 500;
    color: #1a1a1a;
    margin-bottom: 14px;
  }

  .sl-notify-header svg {
    flex-shrink: 0;
  }

  .sl-notify-success {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #2e7d32;
    font-size: 15px;
  }
  .sl-notify-success p { margin: 0; }
  .sl-notify-success svg { flex-shrink: 0; margin-top: 2px; }

  .sl-notify-signed-up {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #2e7d32;
    font-size: 15px;
  }
  .sl-notify-signed-up p { margin: 0 0 4px; }
  .sl-notify-signed-up svg { flex-shrink: 0; margin-top: 2px; }

  .sl-notify-settings-link {
    font-size: 13px;
    color: #555;
    text-decoration: underline;
    transition: color 0.2s;
  }
  .sl-notify-settings-link:hover {
    color: #1a1a1a;
  }
  .sl-notify-account-cta {
    font-size: 13px;
    color: rgba(var(--color-foreground), 0.6);
    margin: 8px 0 0;
  }
  .sl-notify-account-cta a {
    color: #1a1a1a;
    font-weight: 600;
    text-decoration: underline;
  }
  .sl-notify-account-cta a:hover {
    color: #8C9B6D;
  }

  .sl-notify-error {
    color: #c62828;
    font-size: 14px;
    margin-bottom: 10px;
  }
  .sl-notify-error p { margin: 0; }

  .sl-notify-fields {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }

  @media (max-width: 480px) {
    .sl-notify-fields {
      flex-direction: column;
    }
  }

  .sl-notify-input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
    font-family: var(--font-body-family);
    background: #fff;
    color: #1a1a1a;
    outline: none;
    transition: border-color 0.2s;
  }
  .sl-notify-input:focus {
    border-color: #8C9B6D;
  }
  .sl-notify-input--error {
    border-color: #c62828;
  }

  .sl-notify-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 12px 20px;
    background: #1a1a1a;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 15px;
    font-weight: 500;
    font-family: var(--font-body-family);
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .sl-notify-submit:hover {
    opacity: 0.85;
  }
  .sl-notify-submit--full {
    margin-top: 0;
  }

  /* Auto-scroll highlight when coming from collection bell icon */
  .sl-notify-form--highlight {
    animation: sl-notify-pulse 1.5s ease-out;
  }
  @keyframes sl-notify-pulse {
    0% { box-shadow: 0 0 0 0 rgba(140, 155, 109, 0.5); }
    70% { box-shadow: 0 0 0 10px rgba(140, 155, 109, 0); }
    100% { box-shadow: 0 0 0 0 rgba(140, 155, 109, 0); }
  }
</style>

<script>
  (function() {
    var container = document.getElementById('sl-notify-form');
    if (!container) return;

    var handle       = container.getAttribute('data-product-handle');
    var title        = container.getAttribute('data-product-title');
    var image        = container.getAttribute('data-product-image');
    var url          = container.getAttribute('data-product-url');
    var productId    = parseInt(container.getAttribute('data-product-id'));
    var variantId    = parseInt(container.getAttribute('data-variant-id'));
    var variantTitle = container.getAttribute('data-variant-title') || 'Default Title';
    var custId       = container.getAttribute('data-customer-id');
    var custEmail    = container.getAttribute('data-customer-email') || '';
    var storageKey   = custId ? 'sl_bis_' + custId : null;

    /* ---- localStorage helpers ---- */
    function getList() {
      if (!storageKey) return [];
      try { return JSON.parse(localStorage.getItem(storageKey)) || []; }
      catch(e) { return []; }
    }
    function saveList(list) {
      if (!storageKey) return;
      localStorage.setItem(storageKey, JSON.stringify(list));
    }
    function isSignedUp() {
      return getList().some(function(p) { return p.handle === handle; });
    }
    function addProduct() {
      var list = getList();
      if (list.some(function(p) { return p.handle === handle; })) return;
      list.push({ handle: handle, title: title, image: image, url: url, addedAt: new Date().toISOString() });
      saveList(list);
    }

    /* ---- REZ Back-in-Stock API ---- */
    function subscribeViaRez(email) {
      return fetch('/apps/rez/bis/product', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: email,
          variant_id: variantId,
          variant_title: variantTitle,
          store_id: 4307,
          product_name: title,
          product_id: productId,
          locale: 'en'
        })
      });
    }

    /* ---- Show "already signed up" for logged-in customers ---- */
    var signedUpEl = document.getElementById('sl-notify-signed-up');
    var formInner  = document.getElementById('sl-notify-form-inner');
    var bisTagged  = container.getAttribute('data-bis-tagged') === 'true';

    if (custId && (bisTagged || isSignedUp())) {
      if (signedUpEl) signedUpEl.style.display = '';
      if (formInner) formInner.style.display = 'none';
    }

    /* ---- Handle submit button click ---- */
    var submitBtn  = document.getElementById('sl-notify-submit-btn');
    var emailInput = document.getElementById('sl-notify-email');
    var successMsg = document.getElementById('sl-notify-success-msg');
    var formBody   = document.getElementById('sl-notify-form-body');
    var errorEl    = document.getElementById('sl-notify-error');

    if (submitBtn) {
      submitBtn.addEventListener('click', function() {
        var email = custEmail || (emailInput && emailInput.value.trim());

        if (!email) {
          if (emailInput) emailInput.style.borderColor = '#c62828';
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';
        if (errorEl) errorEl.style.display = 'none';

        subscribeViaRez(email)
          .then(function(res) {
            if (!res.ok) throw new Error('REZ API error');
            /* Success */
            addProduct();
            if (formBody) formBody.style.display = 'none';
            if (successMsg) successMsg.style.display = '';
            /* Update signed-up state for logged-in users */
            if (custId && signedUpEl) {
              signedUpEl.style.display = '';
            }
          })
          .catch(function(err) {
            console.warn('REZ BIS subscription failed:', err);
            submitBtn.disabled = false;
            submitBtn.textContent = 'Notify Me';
            if (errorEl) errorEl.style.display = '';
          });
      });
    }

    /* ---- Auto-scroll when ?notify=true is in URL ---- */
    if (window.location.search.indexOf('notify=true') !== -1) {
      setTimeout(function() {
        container.scrollIntoView({ behavior: 'smooth', block: 'center' });
        container.classList.add('sl-notify-form--highlight');
        var firstInput = container.querySelector('.sl-notify-input');
        if (firstInput) firstInput.focus();
      }, 500);
    }
  })();
</script>
